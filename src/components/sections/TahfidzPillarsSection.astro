---
import { Image } from 'astro:assets';
import { Award, BookOpen, GraduationCap, HeartHandshake } from 'lucide-astro';
import { SITE_CONFIG } from '@/data/siteConfig';
import wisudaImg from '@/assets/galeri/wisuda-tahfidz.webp';

interface PillarCard {
  badge: string;
  title: string;
  desc: string;
  icon: 'book' | 'heart' | 'grad' | 'award';
}

const cards: readonly PillarCard[] = [
  {
    badge: 'Target Utama',
    title: 'Wajib Hafal & Paham Arti Juz 30',
    desc: 'Hafalan bertahap dari Kelas 1–6 beserta makna ayat agar diamalkan sehari-hari.',
    icon: 'book',
  },
  {
    badge: 'Ramah Pemula',
    title: 'Bimbingan Mengaji Dari Nol',
    desc: 'Tidak wajib sudah lancar membaca saat masuk; dibimbing sabar mulai Iqra.',
    icon: 'heart',
  },
  {
    badge: 'Syiar Qur’ani',
    title: 'Wisuda Tahfidz Akbar Rutin',
    desc: 'Uji publik tasmi’ hafalan dan prosesi wisuda penuh haru bersama orang tua.',
    icon: 'grad',
  },
  {
    badge: 'Keberkahan Guru',
    title: `${SITE_CONFIG.stats.tahfidzTeachers}+ Guru Hafidz & Umroh Tahunan`,
    desc: `Apresiasi ibadah Umroh rutin bagi ${SITE_CONFIG.stats.annualTeacherUmrahReward} guru teladan setiap tahun.`,
    icon: 'award',
  },
] as const;
---

<!-- Section 6 (#program-tahfidz): Dark Full-Width Student Achievements / Keunggulan (Adaptasi Mutiara Bangsa) -->
<section
  id="program-tahfidz"
  class="scroll-mt-24 relative overflow-hidden bg-primary-dark text-white py-14 md:py-20"
>
  <!-- Latar Foto Wisuda dengan Overlay Gelap -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <Image
      src={wisudaImg}
      alt=""
      class="h-full w-full object-cover opacity-15"
      loading="lazy"
      decoding="async"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-primary-dark/95 via-primary-dark/88 to-primary-dark/95"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-[1280px] px-4 sm:px-6 lg:px-8 space-y-10">
    <!-- Centered Header persis Section 6 Mutiara Bangsa -->
    <div class="text-center space-y-3" data-reveal>
      <span class="inline-block rounded-full bg-gold-medium px-4 py-1 text-xs font-extrabold text-ink-heading">
        Keunggulan &amp; Capaian Santri
      </span>
      <h2 class="font-heading text-2xl sm:text-4xl font-light text-white tracking-tight leading-snug">
        Membina Adab &amp;{' '}
        <strong class="block font-extrabold">Prestasi Tahfidz Al-Qur'an</strong>
      </h2>
    </div>

    <!-- 4-Card Horizontal Strip (Swipe di Mobile, 4 Kolom di Desktop) -->
    <div class="no-scrollbar flex overflow-x-auto snap-x snap-mandatory gap-4 pb-2 -mx-4 px-4 sm:mx-0 sm:px-0 md:grid md:grid-cols-12 md:gap-5 md:overflow-visible md:pb-0">
      {
        cards.map((card, idx) => (
          <article
            data-reveal
            data-reveal-delay={idx * 70}
            class="shrink-0 w-[80%] sm:w-[46%] snap-start md:w-auto md:col-span-6 lg:col-span-3 rounded-2xl bg-white/10 backdrop-blur-md border border-white/15 p-6 flex flex-col justify-between gap-5 hover:bg-white/15 transition-colors"
          >
            <div class="space-y-3">
              <div class="flex items-center justify-between gap-2">
                <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-gold-medium text-ink-heading">
                  {card.icon === 'book' && <BookOpen class="h-5 w-5" aria-hidden="true" />}
                  {card.icon === 'heart' && <HeartHandshake class="h-5 w-5" aria-hidden="true" />}
                  {card.icon === 'grad' && <GraduationCap class="h-5 w-5" aria-hidden="true" />}
                  {card.icon === 'award' && <Award class="h-5 w-5" aria-hidden="true" />}
                </span>
                <span class="rounded-full bg-white/10 px-2.5 py-0.5 text-[11px] font-semibold text-gold-light">
                  {card.badge}
                </span>
              </div>

              <h3 class="font-heading text-lg font-bold text-white leading-snug">
                {card.title}
              </h3>

              <p class="text-xs sm:text-sm text-emerald-50/85 leading-relaxed">
                {card.desc}
              </p>
            </div>
          </article>
        ))
      }
    </div>

    <!-- Bar Kutipan Hadits (Amiri) Ringkas -->
    <div class="mx-auto max-w-3xl rounded-2xl bg-white/5 border border-white/15 px-5 py-4 flex flex-col sm:flex-row items-center justify-between gap-3 text-center sm:text-left">
      <p lang="ar" dir="rtl" class="font-arabic text-xl sm:text-2xl font-bold text-gold-light">
        خَيْرُكُمْ مَنْ تَعَلَّمَ الْقُرْآنَ وَعَلَّمَهُ
      </p>
      <p class="text-xs text-emerald-100/85">
        “Sebaik-baik kalian adalah yang belajar Al-Qur'an dan mengajarkannya.” — <span class="font-semibold text-gold-light">HR. Al-Bukhari</span>
      </p>
    </div>
  </div>
</section>
