---
import { getCollection } from 'astro:content';
import { ChevronLeft, ChevronRight, ShieldCheck, UserCheck } from 'lucide-astro';

const testimonials = await getCollection('testimonials');

const sortedTestimonials = [...testimonials].sort((a, b) => {
  if (a.data.unitRelated === 'Yayasan') return 1;
  if (b.data.unitRelated === 'Yayasan') return -1;
  return 0;
});
---

<!-- Section 10 (#testimoni): Centered Carousel Testimoni (Adaptasi Persis Mutiara Bangsa) -->
<section
  id="testimoni"
  class="scroll-mt-24 py-14 md:py-20 bg-white border-t border-stone-200/80"
>
  <div class="mx-auto max-w-[1280px] px-4 sm:px-6 lg:px-8 space-y-8">
    <!-- Centered Header ala Mutiara Bangsa: "Testimoni. / Apa kata orang tua & pengawas" -->
    <div class="text-center space-y-1.5" data-reveal>
      <h2 class="font-heading text-2xl sm:text-3xl lg:text-4xl font-extrabold text-primary-dark tracking-tight">
        Testimoni.
      </h2>
      <p class="text-sm sm:text-base text-ink-body">
        Apa kata wali murid &amp; pengawas tentang MI TPI &amp; YPI Al-Fuad
      </p>
    </div>

    <!-- Centered Ice-Surface Carousel Card -->
    <div class="mx-auto max-w-3xl relative">
      <div class="rounded-3xl bg-[#F4F7F6] border border-stone-200/90 p-6 sm:p-10 text-center">
        {
          sortedTestimonials.map((item, idx) => {
            const isKemenag = item.data.unitRelated === 'Yayasan';
            return (
              <article
                data-testimonial-slide={idx}
                class={idx === 0 ? 'space-y-5' : 'hidden space-y-5'}
              >
                <div class="flex flex-col items-center gap-2.5">
                  <span
                    class={`flex h-12 w-12 items-center justify-center rounded-full shadow-sm ${
                      isKemenag
                        ? 'bg-amber-700 text-white'
                        : 'bg-primary-dark text-gold-light'
                    }`}
                    aria-hidden="true"
                  >
                    {isKemenag ? (
                      <ShieldCheck class="h-6 w-6" />
                    ) : (
                      <UserCheck class="h-6 w-6" />
                    )}
                  </span>

                  <div>
                    <p class="font-heading text-base font-bold text-primary-dark">
                      {item.data.authorName}
                    </p>
                    <p class="text-xs sm:text-sm font-semibold text-primary">
                      {item.data.authorRole}
                    </p>
                  </div>
                </div>

                <blockquote class="mx-auto max-w-xl text-sm sm:text-base text-ink-subheading leading-relaxed">
                  “{item.data.quote}”
                </blockquote>
              </article>
            );
          })
        }

        <!-- Controls + Pagination Dots (Persis Mutiara Bangsa) -->
        <div class="mt-6 pt-5 border-t border-stone-200/80 flex items-center justify-between gap-4">
          <button
            type="button"
            id="testimonial-prev"
            aria-label="Testimoni sebelumnya"
            class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-white border border-stone-200 text-primary-dark hover:bg-primary-surface transition-colors"
          >
            <ChevronLeft class="h-4 w-4" aria-hidden="true" />
          </button>

          <div class="flex items-center gap-2" role="group" aria-label="Pilih testimoni">
            {
              sortedTestimonials.map((item, idx) => (
                <button
                  type="button"
                  data-testimonial-dot={idx}
                  aria-label={`Testimoni ${item.data.authorName}`}
                  class={`h-2.5 rounded-full transition-all ${
                    idx === 0 ? 'w-6 bg-primary-dark' : 'w-2.5 bg-stone-300 hover:bg-primary/50'
                  }`}
                />
              ))
            }
          </div>

          <button
            type="button"
            id="testimonial-next"
            aria-label="Testimoni berikutnya"
            class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-white border border-stone-200 text-primary-dark hover:bg-primary-surface transition-colors"
          >
            <ChevronRight class="h-4 w-4" aria-hidden="true" />
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const slides = document.querySelectorAll<HTMLElement>('[data-testimonial-slide]');
  const dots = document.querySelectorAll<HTMLButtonElement>('[data-testimonial-dot]');
  const total = slides.length;
  let current = 0;

  const showSlide = (idx: number) => {
    if (total === 0) return;
    current = (idx + total) % total;
    slides.forEach((s, i) => s.classList.toggle('hidden', i !== current));
    dots.forEach((d, i) => {
      const active = i === current;
      d.classList.toggle('w-6', active);
      d.classList.toggle('bg-primary-dark', active);
      d.classList.toggle('w-2.5', !active);
      d.classList.toggle('bg-stone-300', !active);
    });
  };

  dots.forEach((dot, i) => dot.addEventListener('click', () => showSlide(i)));
  document.getElementById('testimonial-prev')?.addEventListener('click', () => showSlide(current - 1));
  document.getElementById('testimonial-next')?.addEventListener('click', () => showSlide(current + 1));
</script>
