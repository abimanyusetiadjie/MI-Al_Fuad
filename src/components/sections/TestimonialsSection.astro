---
import { getCollection } from 'astro:content';
import { CheckCircle2, Quote, ShieldCheck, Star } from 'lucide-astro';

const testimonials = await getCollection('testimonials');

// Tempatkan apresiasi Pengawas Kemenag di akhir atau awal secara seimbang; di sini kita susun berurutan dengan wali murid dulu
const sortedTestimonials = [...testimonials].sort((a, b) => {
  if (a.data.unitRelated === 'Yayasan') return 1;
  if (b.data.unitRelated === 'Yayasan') return -1;
  return 0;
});
---

<section
  id="testimoni"
  class="scroll-mt-24 py-16 md:py-24 bg-surface-cream/60 border-b border-primary-dark/10"
>
  <div class="container-12 gap-y-8">
    <!-- Section Heading -->
    <div class="col-span-12 lg:col-span-8 space-y-4">
      <span
        class="inline-flex items-center gap-2 rounded-full bg-white px-3.5 py-1.5 text-xs sm:text-sm font-semibold text-primary-dark border border-primary/20 shadow-sm"
      >
        <Star class="h-4 w-4 text-gold shrink-0" aria-hidden="true" />
        <span>Suara Wali Murid &amp; Apresiasi Pengawas</span>
      </span>

      <h2
        class="font-heading text-2xl sm:text-3xl lg:text-4xl font-bold text-ink-heading leading-tight"
      >
        Dipercaya Orang Tua di Poris Indah, Batuceper, Cipondoh &amp; Kalideres
      </h2>

      <p class="text-base sm:text-lg text-ink-body leading-relaxed">
        Perubahan adab Ananda, kemampuan membaca serta menghafal Juz 30 beserta
        artinya, dan suasana sekolah yang sejuk adalah bukti nyata amanah kami
        sejak tahun 1990.
      </p>
    </div>

    <div class="col-span-12 lg:col-span-4 flex lg:items-end lg:justify-end">
      <div
        class="w-full lg:w-auto rounded-2xl bg-primary-dark text-white px-5 py-3.5 shadow-sm border border-primary-medium/40"
      >
        <p class="font-heading text-sm font-bold text-gold-light">
          Amanah Keluarga Muslim Tangerang
        </p>
        <p class="mt-0.5 text-xs text-emerald-100/85">
          Dibimbing 52+ Ustadz/Ustadzah Hafidz &amp; Terdaftar Kemenag
        </p>
      </div>
    </div>

    <!-- Grid 6 Kartu Testimoni (3 Kolom Desktop, 2 Kolom Tablet, 1 Kolom Mobile) -->
    {
      sortedTestimonials.map((item) => {
        const isKemenag = item.data.unitRelated === 'Yayasan';
        return (
          <article
            class={`col-span-12 md:col-span-6 lg:col-span-4 rounded-3xl p-6 sm:p-7 border shadow-sm flex flex-col justify-between gap-5 transition-shadow hover:shadow-md ${
              isKemenag
                ? 'bg-primary-dark text-white border-gold/40'
                : 'bg-white text-ink-body border-primary-dark/12'
            }`}
          >
            <div class="space-y-4">
              <!-- Baris Badge Jenjang & Ikon Kutipan -->
              <div class="flex items-center justify-between gap-2">
                <span
                  class={`inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-bold ${
                    isKemenag
                      ? 'bg-amber-700 text-white'
                      : 'bg-primary-surface text-primary-dark border border-primary/20'
                  }`}
                >
                  {isKemenag ? (
                    <ShieldCheck class="h-3.5 w-3.5 shrink-0" aria-hidden="true" />
                  ) : (
                    <CheckCircle2 class="h-3.5 w-3.5 text-primary shrink-0" aria-hidden="true" />
                  )}
                  <span>
                    {isKemenag
                      ? 'Apresiasi Kemenag'
                      : `Wali Murid ${item.data.unitRelated}`}
                  </span>
                </span>

                <Quote
                  class={`h-6 w-6 shrink-0 ${
                    isKemenag ? 'text-gold-medium/70' : 'text-gold/45'
                  }`}
                  aria-hidden="true"
                />
              </div>

              <!-- Kutipan Testimoni -->
              <blockquote
                class={`text-sm sm:text-[15px] leading-relaxed ${
                  isKemenag ? 'text-emerald-50/95' : 'text-ink-subheading'
                }`}
              >
                “{item.data.quote}”
              </blockquote>
            </div>

            <!-- Identitas Penulis -->
            <footer
              class={`pt-4 border-t ${
                isKemenag ? 'border-white/15' : 'border-primary-dark/10'
              }`}
            >
              <p
                class={`font-heading text-sm font-bold ${
                  isKemenag ? 'text-gold-light' : 'text-ink-heading'
                }`}
              >
                {item.data.authorName}
              </p>
              <p
                class={`mt-0.5 text-xs ${
                  isKemenag ? 'text-emerald-100/80' : 'text-ink-caption'
                }`}
              >
                {item.data.authorRole}
              </p>
            </footer>
          </article>
        );
      })
    }
  </div>
</section>
