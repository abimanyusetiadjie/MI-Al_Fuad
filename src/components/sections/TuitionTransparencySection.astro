---
import { ArrowRight, Download, ShieldCheck } from 'lucide-astro';
import { PPDB_FEES_BY_UNIT } from '@/data/ppdbData';
import type { UnitId } from '@/data/siteConfig';
import { formatRupiah } from '@/utils/currency';
import type { TARGET_UNIT_OPTIONS } from '@/utils/whatsapp';

type TargetUnitOption = (typeof TARGET_UNIT_OPTIONS)[number];

const UNIT_TO_PPDB_OPTION: Record<UnitId, TargetUnitOption> = {
  ra: 'RA Al-Fuad',
  mit: 'MI TPI Al-Fuad (Setara SD Islam)',
  smpit: 'SMP-IT Al-Fuad',
  smkit: 'SMK-IT Al-Fuad',
  pesantren: 'Pondok Pesantren',
};

const defaultActiveUnitId: UnitId = 'mit';
---

<section
  id="biaya-ppdb"
  class="scroll-mt-24 py-14 md:py-20 bg-white border-b border-line-subtle"
>
  <div class="mx-auto max-w-[1280px] px-4 sm:px-6 lg:px-8 space-y-12">
    <!-- Top Admission Open Banner -->
    <div
      data-reveal
      class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-surface-sage via-white to-accent-surface/70 border border-line-subtle py-10 px-6 text-center space-y-3"
    >
      <p class="font-heading text-xl sm:text-3xl lg:text-4xl font-extrabold uppercase tracking-wide text-primary-dark">
        PENDAFTARAN PESERTA DIDIK BARU!
      </p>
      <p class="font-heading text-base sm:text-xl font-bold text-accent">
        &mdash; Tahun Ajaran 2026 / 2027
      </p>
      <p class="mx-auto max-w-xl text-xs sm:text-sm text-ink-body">
        DSP/Uang Pangkal dapat diangsur hingga 3x. Tersedia potongan Gelombang Dini, saudara kandung, dan beasiswa tahfidz/yatim.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
        <a
          href="#daftar-ppdb"
          class="inline-flex items-center justify-center min-h-[46px] rounded-xl bg-accent-surface hover:bg-emerald-100 border border-accent/25 px-6 py-2.5 text-sm font-bold text-accent transition-colors"
        >
          Daftar Sekarang
        </a>
        <a
          href="/brosur/brosur-ppdb-ypi-alfuad-2026.pdf"
          download="Brosur-PPDB-YPI-Al-Fuad.pdf"
          class="inline-flex items-center gap-2 min-h-[46px] rounded-xl bg-white hover:bg-surface-alabaster border border-line-subtle px-5 py-2.5 text-xs sm:text-sm font-semibold text-ink-heading transition-colors"
        >
          <Download class="h-4 w-4 text-accent shrink-0" aria-hidden="true" />
          <span>Unduh Brosur (PDF)</span>
        </a>
      </div>
    </div>

    <!-- Rincian Biaya Transparan per Jenjang -->
    <div class="space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 text-center sm:text-left">
        <div>
          <p class="text-xs font-bold uppercase tracking-wider text-gold-text">
            Transparansi Rincian Biaya
          </p>
          <h2 class="font-heading text-xl sm:text-2xl font-extrabold text-primary-dark">
            Estimasi Biaya Masuk &amp; SPP Bulanan
          </h2>
        </div>

        <div
          role="tablist"
          aria-label="Pilih Jenjang untuk Melihat Rincian Biaya"
          class="flex flex-wrap items-center justify-center sm:justify-end gap-2 pb-1"
        >
          {
            PPDB_FEES_BY_UNIT.map((unit) => {
              const isActive = unit.unitId === defaultActiveUnitId;
              return (
                <button
                  type="button"
                  role="tab"
                  id={`tab-fee-${unit.unitId}`}
                  aria-selected={isActive ? 'true' : 'false'}
                  aria-controls={`panel-fee-${unit.unitId}`}
                  data-fee-tab={unit.unitId}
                  class={`min-h-[44px] rounded-xl px-4 py-2 text-xs sm:text-sm font-semibold whitespace-nowrap transition-all border ${
                    isActive
                      ? 'bg-primary-dark text-white border-primary-dark'
                      : 'bg-surface-alabaster text-ink-subheading border-line-subtle hover:border-accent'
                  }`}
                >
                  {unit.shortLabel}
                </button>
              );
            })
          }
        </div>
      </div>

      {
        PPDB_FEES_BY_UNIT.map((unit) => {
          const isActive = unit.unitId === defaultActiveUnitId;
          const ppdbOptionValue = UNIT_TO_PPDB_OPTION[unit.unitId];
          const quotaPercent = Math.round((unit.quotaFilled / unit.quotaTotal) * 100);
          const isLimitedQuota = unit.quotaStatus === 'Segera Penuh';

          return (
            <div
              id={`panel-fee-${unit.unitId}`}
              role="tabpanel"
              aria-labelledby={`tab-fee-${unit.unitId}`}
              data-fee-panel={unit.unitId}
              class={isActive ? 'grid grid-cols-12 gap-5 items-stretch' : 'hidden grid grid-cols-12 gap-5 items-stretch'}
            >
              <div class="col-span-12 lg:col-span-7 rounded-2xl bg-surface-alabaster border border-line-subtle p-5 sm:p-7 flex flex-col justify-between gap-4">
                <div class="flex flex-wrap items-center justify-between gap-2 pb-3 border-b border-line-subtle">
                  <div>
                    <h3 class="font-heading text-lg sm:text-xl font-bold text-ink-heading">
                      {unit.unitName}
                    </h3>
                    <span class="inline-flex items-center gap-1 mt-1 text-xs font-mono font-semibold text-primary-dark">
                      <ShieldCheck class="h-3.5 w-3.5 text-accent" aria-hidden="true" />
                      {unit.npsn === 'Terdaftar Kemenag' ? unit.npsn : `NPSN ${unit.npsn}`}
                    </span>
                  </div>
                  <span
                    class={`rounded-full px-3 py-1 text-xs font-bold ${
                      isLimitedQuota
                        ? 'bg-status-warningBg text-status-warningText'
                        : 'bg-status-successBg text-status-successText'
                    }`}
                  >
                    {unit.quotaStatus} &bull; {unit.quotaRemaining} Kursi
                  </span>
                </div>

                <div class="overflow-x-auto">
                  <table class="min-w-[280px] w-full text-left border-collapse">
                    <tbody class="divide-y divide-line-subtle text-xs sm:text-sm">
                      <tr>
                        <td class="py-2.5 text-ink-body">Formulir Pendaftaran</td>
                        <td class="py-2.5 text-right font-semibold text-ink-heading whitespace-nowrap">
                          {formatRupiah(unit.registrationFormFee)}
                        </td>
                      </tr>
                      <tr>
                        <td class="py-2.5 text-ink-body">DSP / Uang Pangkal</td>
                        <td class="py-2.5 text-right font-semibold text-ink-heading whitespace-nowrap">
                          {formatRupiah(unit.entranceFee)}
                        </td>
                      </tr>
                      <tr>
                        <td class="py-2.5 text-ink-body">Paket Seragam</td>
                        <td class="py-2.5 text-right font-semibold text-ink-heading whitespace-nowrap">
                          {formatRupiah(unit.uniformFee)}
                        </td>
                      </tr>
                      <tr>
                        <td class="py-2.5 text-ink-body">Buku, Modul &amp; Kegiatan Tahunan</td>
                        <td class="py-2.5 text-right font-semibold text-ink-heading whitespace-nowrap">
                          {formatRupiah(unit.activityFee)}
                        </td>
                      </tr>
                      <tr>
                        <td class="py-2.5 text-ink-body">SPP / Infaq Bulanan</td>
                        <td class="py-2.5 text-right font-semibold text-accent whitespace-nowrap">
                          {formatRupiah(unit.monthlyTuition)} / bln
                        </td>
                      </tr>
                      <tr class="bg-white">
                        <td class="py-3 px-2.5 rounded-l-lg font-heading font-bold text-primary-dark">
                          Total Estimasi Daftar Ulang
                        </td>
                        <td class="py-3 px-2.5 rounded-r-lg text-right font-heading text-sm sm:text-base font-extrabold text-primary-dark whitespace-nowrap">
                          {formatRupiah(unit.totalEstimatedInitial)}
                        </td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </div>

              <div class="col-span-12 lg:col-span-5 rounded-2xl bg-primary-dark text-white p-6 sm:p-7 flex flex-col justify-between gap-6">
                <div class="space-y-4">
                  <div class="space-y-2">
                    <div class="flex items-center justify-between text-xs font-semibold">
                      <span class="text-emerald-100/80">Keterisian Kuota</span>
                      <span class="text-gold-light">{unit.quotaFilled} / {unit.quotaTotal} Siswa</span>
                    </div>
                    <div class="h-2 w-full rounded-full bg-white/15 overflow-hidden">
                      <div class="h-full rounded-full bg-gold" style={`width: ${quotaPercent}%`} />
                    </div>
                  </div>
                  <p class="text-xs sm:text-sm text-emerald-50/90 leading-relaxed">
                    {unit.installmentNote}
                  </p>
                </div>

                <div class="space-y-2.5">
                  <a
                    href="#daftar-ppdb"
                    data-select-unit={ppdbOptionValue}
                    data-unit-id={unit.unitId}
                    class="inline-flex w-full items-center justify-center gap-2 min-h-[48px] rounded-xl bg-gold hover:bg-gold-hover px-4 py-3 text-sm font-bold text-ink-heading shadow-sm transition-colors"
                  >
                    <span>Daftar {unit.shortLabel} Sekarang</span>
                    <ArrowRight class="h-4 w-4 shrink-0" aria-hidden="true" />
                  </a>
                  <a
                    href="/brosur/rincian-biaya-ypi-alfuad.pdf"
                    download={`Rincian-Biaya-${unit.shortLabel}-Al-Fuad.pdf`}
                    class="inline-flex w-full items-center justify-center gap-2 min-h-[44px] rounded-xl border border-white/25 bg-white/10 hover:bg-white/20 px-4 py-2.5 text-xs sm:text-sm font-medium text-white transition-colors"
                  >
                    <Download class="h-4 w-4 shrink-0" aria-hidden="true" />
                    <span>Simpan Rincian PDF</span>
                  </a>
                </div>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>

<script>
  const feeTabs = document.querySelectorAll<HTMLButtonElement>('[data-fee-tab]');
  const feePanels = document.querySelectorAll<HTMLElement>('[data-fee-panel]');

  const activateFeeTab = (unitId: string) => {
    feeTabs.forEach((tab) => {
      const isSelected = tab.getAttribute('data-fee-tab') === unitId;
      tab.setAttribute('aria-selected', String(isSelected));
      tab.classList.toggle('bg-primary-dark', isSelected);
      tab.classList.toggle('text-white', isSelected);
      tab.classList.toggle('border-primary-dark', isSelected);
      tab.classList.toggle('bg-surface-alabaster', !isSelected);
      tab.classList.toggle('text-ink-subheading', !isSelected);
      tab.classList.toggle('border-line-subtle', !isSelected);
    });

    feePanels.forEach((panel) => {
      const isMatch = panel.getAttribute('data-fee-panel') === unitId;
      panel.classList.toggle('hidden', !isMatch);
    });
  };

  feeTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const unitId = tab.getAttribute('data-fee-tab');
      if (unitId) activateFeeTab(unitId);
    });
  });

  window.addEventListener('ppdb:select-unit', (event) => {
    const customEvent = event as CustomEvent<{ unitId?: string }>;
    if (customEvent.detail?.unitId) {
      activateFeeTab(customEvent.detail.unitId);
    }
  });
</script>
