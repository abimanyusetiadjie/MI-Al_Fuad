---
import {
  ArrowRight,
  Calendar,
  CheckCircle2,
  Download,
  Info,
  ShieldCheck,
  Wallet,
} from 'lucide-astro';
import { PPDB_FEES_BY_UNIT, PPDB_WAVES } from '@/data/ppdbData';
import type { UnitId } from '@/data/siteConfig';
import { formatRupiah } from '@/utils/currency';
import type { TARGET_UNIT_OPTIONS } from '@/utils/whatsapp';

type TargetUnitOption = (typeof TARGET_UNIT_OPTIONS)[number];

const UNIT_TO_PPDB_OPTION: Record<UnitId, TargetUnitOption> = {
  ra: 'RA Al-Fuad',
  mit: 'MI TPI Al-Fuad (Setara SD Islam)',
  smpit: 'SMP-IT Al-Fuad',
  smkit: 'SMK-IT Al-Fuad',
  pesantren: 'Pondok Pesantren',
};

const defaultActiveUnitId: UnitId = 'ra';
---

<section
  id="biaya-ppdb"
  class="scroll-mt-24 py-16 md:py-24 bg-surface-cream/70 border-b border-primary-dark/10"
>
  <div class="container-12 gap-y-8">
    <!-- Section Heading -->
    <div class="col-span-12 lg:col-span-8 space-y-4">
      <span
        class="inline-flex items-center gap-2 rounded-full bg-white px-3.5 py-1.5 text-xs sm:text-sm font-semibold text-primary-dark border border-primary/20 shadow-sm"
      >
        <Wallet class="h-4 w-4 text-gold shrink-0" aria-hidden="true" />
        <span>Transparansi Biaya &amp; Gelombang PPDB</span>
      </span>

      <h2
        class="font-heading text-2xl sm:text-3xl lg:text-4xl font-bold text-ink-heading leading-tight"
      >
        Rincian Estimasi Biaya Masuk &amp; Jadwal Gelombang Pendaftaran
      </h2>

      <p class="text-base sm:text-lg text-ink-body leading-relaxed">
        Kami menyajikan estimasi biaya pendidikan secara terbuka untuk membantu
        Ayah &amp; Bunda merencanakan pendidikan Ananda dengan tenang, lengkap
        dengan opsi angsuran uang pangkal dan beasiswa tahfidz.
      </p>
    </div>

    <div class="col-span-12 lg:col-span-4 flex lg:items-end lg:justify-end">
      <a
        href="/brosur/brosur-ppdb-ypi-alfuad-2026.pdf"
        download="Brosur-PPDB-YPI-Al-Fuad-2026.pdf"
        class="inline-flex w-full lg:w-auto items-center justify-center gap-2 min-h-[48px] rounded-xl bg-primary-dark hover:bg-primary text-white px-5 py-3 text-sm font-bold shadow-sm transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
      >
        <Download class="h-4 w-4 text-gold-medium shrink-0" aria-hidden="true" />
        <span>Unduh Brosur &amp; Rincian Biaya (PDF)</span>
      </a>
    </div>

    <!-- Timeline Gelombang Pendaftaran (3 Kartu: col-span-12 md:col-span-4) -->
    <div class="col-span-12">
      <div class="grid grid-cols-12 gap-4 md:gap-6">
        {
          PPDB_WAVES.map((wave) => {
            const isLimited = wave.status === 'Segera Penuh';
            return (
              <article
                class={`col-span-12 md:col-span-4 rounded-2xl bg-white p-5 border ${
                  isLimited
                    ? 'border-gold/50 ring-1 ring-gold/20'
                    : 'border-primary-dark/12'
                } shadow-sm flex flex-col justify-between gap-3`}
              >
                <div class="space-y-2.5">
                  <div class="flex flex-wrap items-center justify-between gap-2">
                    <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-ink-caption">
                      <Calendar class="h-3.5 w-3.5 text-primary shrink-0" aria-hidden="true" />
                      <span>{wave.period}</span>
                    </span>

                    <span
                      class={`inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-bold ${
                        isLimited
                          ? 'bg-gold-light text-amber-800 border border-gold/30'
                          : 'bg-primary-surface text-primary-dark border border-primary/20'
                      }`}
                    >
                      {wave.status}
                    </span>
                  </div>

                  <h3 class="font-heading text-lg font-bold text-ink-heading">
                    {wave.name}
                  </h3>
                </div>

                <p class="text-xs sm:text-sm text-ink-body leading-relaxed">
                  {wave.benefit}
                </p>
              </article>
            );
          })
        }
      </div>
    </div>

    <!-- Tab Interaktif Berdasarkan Jenjang -->
    <div class="col-span-12 space-y-5">
      <div
        role="tablist"
        aria-label="Pilih Jenjang Pendidikan untuk Melihat Rincian Biaya"
        class="flex flex-wrap gap-2 sm:gap-2.5 rounded-2xl bg-white p-2 border border-primary-dark/10 shadow-sm"
      >
        {
          PPDB_FEES_BY_UNIT.map((unit) => {
            const isSelected = unit.unitId === defaultActiveUnitId;
            return (
              <button
                type="button"
                role="tab"
                id={`tab-fee-${unit.unitId}`}
                aria-selected={isSelected ? 'true' : 'false'}
                aria-controls={`panel-fee-${unit.unitId}`}
                data-fee-tab={unit.unitId}
                class={`flex-1 min-w-[110px] sm:min-w-fit min-h-[48px] rounded-xl px-4 py-2.5 text-xs sm:text-sm font-bold transition-all focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary ${
                  isSelected
                    ? 'bg-primary-dark text-white shadow-sm'
                    : 'bg-surface-alabaster text-ink-subheading hover:bg-primary-surface hover:text-primary-dark'
                }`}
              >
                {unit.shortLabel}
              </button>
            );
          })
        }
      </div>

      <!-- Panel Konten Tiap Jenjang -->
      {
        PPDB_FEES_BY_UNIT.map((unit) => {
          const isSelected = unit.unitId === defaultActiveUnitId;
          const isNearlyFull = unit.quotaStatus === 'Segera Penuh';
          const ppdbOptionValue = UNIT_TO_PPDB_OPTION[unit.unitId];

          return (
            <div
              id={`panel-fee-${unit.unitId}`}
              role="tabpanel"
              aria-labelledby={`tab-fee-${unit.unitId}`}
              data-fee-panel={unit.unitId}
              class={isSelected ? 'block' : 'hidden'}
            >
              <div class="grid grid-cols-12 gap-6 items-stretch">
                <!-- Tabel Rincian Biaya (8 Kolom Desktop) -->
                <div class="col-span-12 lg:col-span-8 rounded-3xl bg-white p-5 sm:p-7 border border-primary-dark/12 shadow-sm space-y-5">
                  <div class="flex flex-wrap items-start justify-between gap-3 border-b border-primary-dark/10 pb-4">
                    <div class="space-y-1">
                      <div class="flex flex-wrap items-center gap-2">
                        <span class="inline-flex items-center gap-1 rounded-md bg-primary-dark px-2.5 py-0.5 font-mono text-xs font-bold text-gold-light">
                          <ShieldCheck class="h-3.5 w-3.5 text-gold-medium" aria-hidden="true" />
                          <span>
                            {unit.npsn === 'Terdaftar Kemenag'
                              ? unit.npsn
                              : `NPSN: ${unit.npsn}`}
                          </span>
                        </span>

                        <span
                          class={`inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-bold ${
                            isNearlyFull
                              ? 'bg-gold-light text-amber-800 border border-gold/30'
                              : 'bg-primary-surface text-primary-dark border border-primary/20'
                          }`}
                        >
                          {unit.quotaStatus} &bull; Sisa {unit.quotaRemaining} Kursi
                        </span>
                      </div>

                      <h3 class="font-heading text-xl sm:text-2xl font-bold text-ink-heading">
                        Estimasi Biaya Masuk {unit.unitName}
                      </h3>
                    </div>

                    <span class="text-xs font-medium text-ink-caption">
                      Tahun Ajaran Baru &bull; Transparan
                    </span>
                  </div>

                  <div class="overflow-x-auto -mx-2 px-2 sm:mx-0 sm:px-0 rounded-xl">
                    <table class="min-w-[300px] w-full text-left border-collapse">
                      <thead>
                        <tr class="border-b border-primary-dark/15 text-xs font-bold uppercase tracking-wider text-ink-caption">
                          <th class="py-3 pr-4">Komponen Biaya</th>
                          <th class="py-3 px-2 hidden sm:table-cell">Keterangan</th>
                          <th class="py-3 pl-4 text-right">Estimasi Nominal</th>
                        </tr>
                      </thead>
                      <tbody class="divide-y divide-primary-dark/10 text-sm text-ink-subheading">
                        <tr>
                          <td class="py-3.5 pr-4 font-semibold text-ink-heading">
                            Biaya Formulir &amp; Observasi
                          </td>
                          <td class="py-3.5 px-2 text-xs text-ink-body hidden sm:table-cell">
                            Pendaftaran &amp; pemetaan bacaan Qur'an
                          </td>
                          <td class="py-3.5 pl-4 text-right font-semibold whitespace-nowrap">
                            {formatRupiah(unit.registrationFormFee)}
                          </td>
                        </tr>
                        <tr>
                          <td class="py-3.5 pr-4 font-semibold text-ink-heading">
                            DSP / Uang Pangkal
                          </td>
                          <td class="py-3.5 px-2 text-xs text-ink-body hidden sm:table-cell">
                            Sekali selama masa pendidikan (bisa dicicil)
                          </td>
                          <td class="py-3.5 pl-4 text-right font-semibold whitespace-nowrap">
                            {formatRupiah(unit.entranceFee)}
                          </td>
                        </tr>
                        <tr>
                          <td class="py-3.5 pr-4 font-semibold text-ink-heading">
                            Seragam Sekolah Lengkap
                          </td>
                          <td class="py-3.5 px-2 text-xs text-ink-body hidden sm:table-cell">
                            Seragam harian, Muslim/batik &amp; olahraga
                          </td>
                          <td class="py-3.5 pl-4 text-right font-semibold whitespace-nowrap">
                            {formatRupiah(unit.uniformFee)}
                          </td>
                        </tr>
                        <tr>
                          <td class="py-3.5 pr-4 font-semibold text-ink-heading">
                            Buku Paket / Modul &amp; Kegiatan Tahunan
                          </td>
                          <td class="py-3.5 px-2 text-xs text-ink-body hidden sm:table-cell">
                            Termasuk modul Tahfidz &amp; kegiatan tahunan
                          </td>
                          <td class="py-3.5 pl-4 text-right font-semibold whitespace-nowrap">
                            {formatRupiah(unit.activityFee)}
                          </td>
                        </tr>
                        <tr>
                          <td class="py-3.5 pr-4 font-semibold text-ink-heading">
                            SPP Bulanan (Bulan Pertama)
                          </td>
                          <td class="py-3.5 px-2 text-xs text-ink-body hidden sm:table-cell">
                            {unit.unitId === 'pesantren'
                              ? 'Asrama, makan harian & pembinaan tahfidz'
                              : 'Iuran operasional bulanan sekolah'}
                          </td>
                          <td class="py-3.5 pl-4 text-right font-semibold text-primary-dark whitespace-nowrap">
                            {formatRupiah(unit.monthlyTuition)} / bln
                          </td>
                        </tr>
                      </tbody>
                      <tfoot>
                        <tr class="bg-primary-surface/80 border-t-2 border-primary/30">
                          <td class="py-4 px-3 rounded-l-xl font-heading text-sm sm:text-base font-extrabold text-primary-dark">
                            Estimasi Total Biaya Masuk Awal
                          </td>
                          <td class="py-4 px-2 text-xs font-medium text-primary-dark/80 hidden sm:table-cell">
                            Sebelum potongan Gelombang Inden/Dini &amp; Alumni
                          </td>
                          <td class="py-4 px-3 rounded-r-xl text-right font-heading text-base sm:text-lg font-extrabold text-primary-dark whitespace-nowrap">
                            {formatRupiah(unit.totalEstimatedInitial)}
                          </td>
                        </tr>
                      </tfoot>
                    </table>
                  </div>
                </div>

                <!-- Kartu Keringanan, Cicilan & Aksi (4 Kolom Desktop) -->
                <aside class="col-span-12 lg:col-span-4 rounded-3xl bg-primary-dark text-white p-6 sm:p-7 border border-primary-medium/40 shadow-md flex flex-col justify-between gap-6">
                  <div class="space-y-4">
                    <div class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1 text-xs font-bold text-gold-light border border-gold/30">
                      <Info class="h-3.5 w-3.5 text-gold-medium shrink-0" aria-hidden="true" />
                      <span>Keringanan, Cicilan &amp; Beasiswa</span>
                    </div>

                    <h4 class="font-heading text-lg sm:text-xl font-bold text-white leading-snug">
                      Skema Pembayaran Ringan untuk Ayah &amp; Bunda
                    </h4>

                    <p class="text-sm text-emerald-50/90 leading-relaxed">
                      {unit.installmentNote}
                    </p>

                    <ul class="space-y-2.5 pt-1 text-xs sm:text-sm text-emerald-100/90">
                      <li class="flex items-start gap-2">
                        <CheckCircle2
                          class="h-4 w-4 text-gold-medium shrink-0 mt-0.5"
                          aria-hidden="true"
                        />
                        <span>Angsuran DSP/Uang Pangkal hingga 3 kali bayar</span>
                      </li>
                      <li class="flex items-start gap-2">
                        <CheckCircle2
                          class="h-4 w-4 text-gold-medium shrink-0 mt-0.5"
                          aria-hidden="true"
                        />
                        <span>Potongan Gelombang Inden/Dini hingga Rp 500.000</span>
                      </li>
                      <li class="flex items-start gap-2">
                        <CheckCircle2
                          class="h-4 w-4 text-gold-medium shrink-0 mt-0.5"
                          aria-hidden="true"
                        />
                        <span>Beasiswa Tahfidz &amp; keringanan saudara kandung</span>
                      </li>
                    </ul>
                  </div>

                  <div class="space-y-2.5 pt-2 border-t border-white/15">
                    <a
                      href="#daftar-ppdb"
                      data-select-unit={ppdbOptionValue}
                      data-unit-id={unit.unitId}
                      class="inline-flex w-full items-center justify-center gap-2 min-h-[48px] rounded-xl bg-amber-700 hover:bg-amber-800 px-4 py-3 text-sm font-bold text-white shadow-sm transition-colors"
                    >
                      <span>Daftar {unit.shortLabel} Sekarang</span>
                      <ArrowRight class="h-4 w-4 shrink-0" aria-hidden="true" />
                    </a>

                    <a
                      href="/brosur/brosur-ppdb-ypi-alfuad-2026.pdf"
                      download="Brosur-PPDB-YPI-Al-Fuad-2026.pdf"
                      class="inline-flex w-full items-center justify-center gap-2 min-h-[48px] rounded-xl border border-white/25 bg-white/10 hover:bg-white/20 px-4 py-3 text-xs sm:text-sm font-semibold text-white transition-colors"
                    >
                      <Download class="h-4 w-4 shrink-0" aria-hidden="true" />
                      <span>Unduh Brosur &amp; Rincian Biaya (PDF)</span>
                    </a>
                  </div>
                </aside>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    const tabButtons = document.querySelectorAll('[data-fee-tab]');
    const tabPanels = document.querySelectorAll('[data-fee-panel]');
    if (!tabButtons.length || !tabPanels.length) return;

    const activateTab = (targetId) => {
      tabButtons.forEach((btn) => {
        const isCurrent = btn.getAttribute('data-fee-tab') === targetId;
        btn.setAttribute('aria-selected', String(isCurrent));
        btn.classList.toggle('bg-primary-dark', isCurrent);
        btn.classList.toggle('text-white', isCurrent);
        btn.classList.toggle('shadow-sm', isCurrent);
        btn.classList.toggle('bg-surface-alabaster', !isCurrent);
        btn.classList.toggle('text-ink-subheading', !isCurrent);
      });

      tabPanels.forEach((panel) => {
        const isCurrent = panel.getAttribute('data-fee-panel') === targetId;
        panel.classList.toggle('hidden', !isCurrent);
        panel.classList.toggle('block', isCurrent);
      });
    };

    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const unitId = btn.getAttribute('data-fee-tab');
        if (unitId) activateTab(unitId);
      });
    });

    // Sinkronkan tab rincian biaya apabila user mengklik tombol "Pilih Jenjang Ini" di seksi #jenjang
    window.addEventListener('ppdb:select-unit', (event) => {
      const detail = event && event.detail ? event.detail : null;
      if (detail && detail.unitId) {
        activateTab(detail.unitId);
      }
    });
  })();
</script>
