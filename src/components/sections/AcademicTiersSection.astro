---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { ArrowRight, CheckCircle2, ChevronLeft, ChevronRight, Clock, ShieldCheck } from 'lucide-astro';
import { SITE_CONFIG, type UnitId } from '@/data/siteConfig';
import { PPDB_FEES_BY_UNIT } from '@/data/ppdbData';
import { formatRupiah } from '@/utils/currency';
import type { TARGET_UNIT_OPTIONS } from '@/utils/whatsapp';
import heroMiImg from '@/assets/hero-mi-alfuad.webp';
import wisudaImg from '@/assets/galeri/wisuda-tahfidz.webp';
import kelasImg from '@/assets/galeri/ruang-kelas-mi.webp';
import labImg from '@/assets/galeri/lab-komputer-smkit.webp';
import masjidImg from '@/assets/galeri/masjid-at-taqwa.webp';

type TargetUnitOption = (typeof TARGET_UNIT_OPTIONS)[number];

const UNIT_TO_PPDB_OPTION: Record<UnitId, TargetUnitOption> = {
  ra: 'RA Al-Fuad',
  mit: 'MI TPI Al-Fuad (Setara SD Islam)',
  smpit: 'SMP-IT Al-Fuad',
  smkit: 'SMK-IT Al-Fuad',
  pesantren: 'Pondok Pesantren',
};

const UNIT_IMAGES: Record<UnitId, ImageMetadata> = {
  ra: kelasImg,
  mit: heroMiImg,
  smpit: wisudaImg,
  smkit: labImg,
  pesantren: masjidImg,
};

const unitsEntries = (await getCollection('units')).sort(
  (a, b) => a.data.order - b.data.order,
);

const defaultUnitId: UnitId = 'mit';
---

<section
  id="jenjang"
  class="scroll-mt-24 py-14 md:py-20 bg-white border-b border-line-subtle"
>
  <div class="mx-auto max-w-[1280px] px-4 sm:px-6 lg:px-8 space-y-8">
    <div class="text-center space-y-1.5" data-reveal>
      <p class="text-[11px] sm:text-xs font-bold uppercase tracking-[0.2em] text-accent">
        LIMA UNIT TERPADU
      </p>
      <h2 class="font-heading text-2xl sm:text-3xl lg:text-4xl font-extrabold text-primary-dark tracking-tight">
        Satu Kawasan Pendidikan di Poris Gaga
      </h2>
    </div>

    <!-- Pill Tabs Pemilih Cepat Unit (Centered di Mobile & Desktop) -->
    <div class="flex flex-wrap items-center justify-center gap-2 pb-1">
      {
        unitsEntries.map((unit) => {
          const isActive = unit.data.unitId === defaultUnitId;
          const feeInfo = PPDB_FEES_BY_UNIT.find((f) => f.unitId === unit.data.unitId);
          return (
            <button
              type="button"
              data-campus-tab={unit.data.unitId}
              aria-pressed={isActive ? 'true' : 'false'}
              class={`min-h-[44px] rounded-xl px-4 py-2 text-xs sm:text-sm font-semibold whitespace-nowrap border transition-all ${
                isActive
                  ? 'bg-primary-dark text-white border-primary-dark shadow-sm'
                  : 'bg-surface-alabaster text-ink-subheading border-line-subtle hover:border-accent'
              }`}
            >
              {feeInfo?.shortLabel ?? unit.data.title}
            </button>
          );
        })
      }
    </div>

    <!-- 2-Column Slide Showcase -->
    <div class="relative rounded-3xl bg-surface-alabaster border border-line-subtle p-5 sm:p-8 lg:p-10">
      {
        unitsEntries.map((unit) => {
          const isActive = unit.data.unitId === defaultUnitId;
          const unitMeta = SITE_CONFIG.units.find((u) => u.id === unit.data.unitId);
          const feeInfo = PPDB_FEES_BY_UNIT.find((f) => f.unitId === unit.data.unitId);
          const ppdbOptionValue = UNIT_TO_PPDB_OPTION[unit.data.unitId];
          const unitPhoto = UNIT_IMAGES[unit.data.unitId];
          const isLimitedQuota = feeInfo?.quotaStatus === 'Segera Penuh';

          return (
            <article
              data-campus-slide={unit.data.unitId}
              class={isActive ? 'grid grid-cols-12 gap-6 lg:gap-10 items-center' : 'hidden grid grid-cols-12 gap-6 lg:gap-10 items-center'}
            >
              <div class="col-span-12 lg:col-span-6">
                <div class="overflow-hidden rounded-2xl border border-line-subtle bg-white p-1.5 shadow-sm">
                  <Image
                    src={unitPhoto}
                    alt={`${unit.data.title} — ${SITE_CONFIG.address.subdistrict}, ${SITE_CONFIG.address.city}`}
                    class="w-full h-auto aspect-[16/10] rounded-xl object-cover"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </div>

              <div class="col-span-12 lg:col-span-6 space-y-4 text-center lg:text-left">
                <div class="flex flex-wrap items-center justify-center lg:justify-start gap-2">
                  <span class="text-xs font-bold uppercase tracking-[0.15em] text-gold-text">
                    PORIS GAGA CAMPUS
                  </span>
                  <span class="inline-flex items-center gap-1 rounded-md bg-white px-2.5 py-0.5 font-mono text-xs font-bold text-primary-dark border border-line-subtle">
                    <ShieldCheck class="h-3.5 w-3.5 text-accent" aria-hidden="true" />
                    {unit.data.npsn === 'Terdaftar Kemenag' ? 'Terdaftar Kemenag' : `NPSN ${unit.data.npsn}`}
                  </span>
                </div>

                <div>
                  <h3 class="font-heading text-2xl sm:text-3xl font-extrabold text-primary-dark tracking-tight uppercase">
                    {unit.data.title}
                  </h3>
                  <p class="mt-1 text-sm font-semibold text-accent">
                    {unitMeta?.levelLabel} &bull; {unit.data.tahfidzTarget}
                  </p>
                </div>

                <p class="text-xs sm:text-sm text-ink-body leading-relaxed">
                  {unitMeta?.shortDesc}
                </p>

                {unitMeta?.highlights && (
                  <ul class="space-y-1.5 text-xs sm:text-sm text-ink-heading text-left bg-white/80 rounded-xl p-3.5 border border-line-subtle">
                    {unitMeta.highlights.map((item) => (
                      <li class="flex items-start gap-2">
                        <CheckCircle2 class="h-4 w-4 text-accent shrink-0 mt-0.5" aria-hidden="true" />
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                )}

                <p class="flex items-center justify-center lg:justify-start gap-2 text-xs font-semibold text-primary-dark">
                  <Clock class="h-4 w-4 text-accent shrink-0" aria-hidden="true" />
                  <span>Jam Belajar: {unit.data.studyHours}</span>
                </p>

                {feeInfo && (
                  <div class="rounded-xl bg-white px-4 py-3 border border-line-subtle flex flex-wrap items-center justify-center lg:justify-between gap-2 text-xs">
                    <span>
                      SPP Bulanan: <strong class="text-primary-dark font-bold">{formatRupiah(feeInfo.monthlyTuition)}</strong>
                    </span>
                    <span
                      class={`rounded-full px-2.5 py-0.5 font-bold ${
                        isLimitedQuota
                          ? 'bg-status-warningBg text-status-warningText'
                          : 'bg-status-successBg text-status-successText'
                      }`}
                    >
                      {feeInfo.quotaStatus} ({feeInfo.quotaRemaining} Kursi)
                    </span>
                  </div>
                )}

                <div class="flex flex-wrap items-center justify-center lg:justify-start gap-3 pt-1">
                  <a
                    href="#daftar-ppdb"
                    data-select-unit={ppdbOptionValue}
                    data-unit-id={unit.data.unitId}
                    class="inline-flex items-center justify-center gap-2 min-h-[46px] rounded-xl bg-gold hover:bg-gold-hover px-5 py-2.5 text-sm font-bold text-ink-heading shadow-sm transition-colors"
                  >
                    <span>Pilih &amp; Daftar {feeInfo?.shortLabel}</span>
                    <ArrowRight class="h-4 w-4 shrink-0" aria-hidden="true" />
                  </a>

                  <a
                    href="#biaya-ppdb"
                    data-jump-fee-unit={unit.data.unitId}
                    class="inline-flex items-center justify-center min-h-[46px] rounded-xl border border-line-muted bg-white hover:bg-accent-surface px-4 py-2.5 text-xs sm:text-sm font-semibold text-primary-dark transition-colors"
                  >
                    Lihat Rincian Biaya
                  </a>
                </div>
              </div>
            </article>
          );
        })
      }

      <!-- Bottom Carousel Pagination Controls & Dots -->
      <div class="mt-6 pt-5 border-t border-line-subtle flex items-center justify-between gap-4">
        <button
          type="button"
          id="campus-prev"
          aria-label="Unit pendidikan sebelumnya"
          class="inline-flex items-center gap-1.5 min-h-[44px] px-3 rounded-xl border border-line-subtle bg-white text-xs font-semibold text-primary-dark hover:bg-accent-surface transition-colors"
        >
          <ChevronLeft class="h-4 w-4" aria-hidden="true" />
          <span class="hidden sm:inline">Sebelumnya</span>
        </button>

        <div class="flex items-center gap-2" role="group" aria-label="Indikator slide unit">
          {
            unitsEntries.map((unit) => {
              const isActive = unit.data.unitId === defaultUnitId;
              return (
                <button
                  type="button"
                  data-campus-dot={unit.data.unitId}
                  aria-label={`Tampilkan ${unit.data.title}`}
                  class={`h-2.5 rounded-full transition-all ${
                    isActive ? 'w-7 bg-primary-dark' : 'w-2.5 bg-line-muted hover:bg-accent'
                  }`}
                />
              );
            })
          }
        </div>

        <button
          type="button"
          id="campus-next"
          aria-label="Unit pendidikan berikutnya"
          class="inline-flex items-center gap-1.5 min-h-[44px] px-3 rounded-xl border border-line-subtle bg-white text-xs font-semibold text-primary-dark hover:bg-accent-surface transition-colors"
        >
          <span class="hidden sm:inline">Berikutnya</span>
          <ChevronRight class="h-4 w-4" aria-hidden="true" />
        </button>
      </div>
    </div>

    <!-- Bar Ringkas 5 NPSN Resmi -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-2.5">
      {
        SITE_CONFIG.units.map((u) => {
          const isCardActive = u.id === defaultUnitId;
          return (
            <button
              type="button"
              data-campus-tab={u.id}
              data-campus-card={u.id}
              class={`text-left rounded-xl border px-3.5 py-2.5 transition-colors min-h-[44px] ${
                isCardActive
                  ? 'bg-accent-surface border-primary-dark shadow-sm'
                  : 'bg-surface-alabaster hover:bg-accent-surface/70 border-line-subtle'
              }`}
            >
              <p class="font-heading text-xs font-bold text-primary-dark truncate">{u.name}</p>
              <p class="font-mono text-[11px] text-accent font-semibold">
                {u.npsn === 'Terdaftar Kemenag' ? 'Kemenag RI' : `NPSN ${u.npsn}`}
              </p>
            </button>
          );
        })
      }
    </div>
  </div>
</section>

<script>
  const unitOrder = ['ra', 'mit', 'smpit', 'smkit', 'pesantren'];
  let activeCampusId = 'mit';

  const campusTabs = document.querySelectorAll<HTMLButtonElement>('[data-campus-tab]');
  const campusCards = document.querySelectorAll<HTMLButtonElement>('[data-campus-card]');
  const campusSlides = document.querySelectorAll<HTMLElement>('[data-campus-slide]');
  const campusDots = document.querySelectorAll<HTMLButtonElement>('[data-campus-dot]');

  const showCampusSlide = (unitId: string) => {
    if (!unitOrder.includes(unitId)) return;
    activeCampusId = unitId;

    campusSlides.forEach((slide) => {
      const match = slide.getAttribute('data-campus-slide') === unitId;
      slide.classList.toggle('hidden', !match);
    });

    campusTabs.forEach((tab) => {
      if (!tab.hasAttribute('aria-pressed')) return;
      const match = tab.getAttribute('data-campus-tab') === unitId;
      tab.setAttribute('aria-pressed', String(match));
      tab.classList.toggle('bg-primary-dark', match);
      tab.classList.toggle('text-white', match);
      tab.classList.toggle('border-primary-dark', match);
      tab.classList.toggle('bg-surface-alabaster', !match);
      tab.classList.toggle('text-ink-subheading', !match);
      tab.classList.toggle('border-line-subtle', !match);
    });

    campusCards.forEach((card) => {
      const match = card.getAttribute('data-campus-card') === unitId;
      card.classList.toggle('bg-accent-surface', match);
      card.classList.toggle('border-primary-dark', match);
      card.classList.toggle('shadow-sm', match);
      card.classList.toggle('bg-surface-alabaster', !match);
      card.classList.toggle('hover:bg-accent-surface/70', !match);
      card.classList.toggle('border-line-subtle', !match);
    });

    campusDots.forEach((dot) => {
      const match = dot.getAttribute('data-campus-dot') === unitId;
      dot.classList.toggle('w-7', match);
      dot.classList.toggle('bg-primary-dark', match);
      dot.classList.toggle('w-2.5', !match);
      dot.classList.toggle('bg-line-muted', !match);
    });
  };

  campusTabs.forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-campus-tab');
      if (id) showCampusSlide(id);
    });
  });

  campusDots.forEach((dot) => {
    dot.addEventListener('click', () => {
      const id = dot.getAttribute('data-campus-dot');
      if (id) showCampusSlide(id);
    });
  });

  document.getElementById('campus-prev')?.addEventListener('click', () => {
    const idx = unitOrder.indexOf(activeCampusId);
    const prevIdx = (idx - 1 + unitOrder.length) % unitOrder.length;
    showCampusSlide(unitOrder[prevIdx]);
  });

  document.getElementById('campus-next')?.addEventListener('click', () => {
    const idx = unitOrder.indexOf(activeCampusId);
    const nextIdx = (idx + 1) % unitOrder.length;
    showCampusSlide(unitOrder[nextIdx]);
  });

  window.addEventListener('campus:select-slide', (event) => {
    const customEvent = event as CustomEvent<{ unitId?: string }>;
    if (customEvent.detail?.unitId) {
      showCampusSlide(customEvent.detail.unitId);
    }
  });

  document.querySelectorAll('[data-jump-fee-unit]').forEach((link) => {
    link.addEventListener('click', () => {
      const unitId = link.getAttribute('data-jump-fee-unit');
      if (unitId) {
        window.dispatchEvent(new CustomEvent('ppdb:select-unit', { detail: { unitId } }));
      }
    });
  });

  const unitButtons = document.querySelectorAll('[data-select-unit]');
  unitButtons.forEach((button) => {
    button.addEventListener('click', (event) => {
      const targetUnit = button.getAttribute('data-select-unit');
      const targetUnitId = button.getAttribute('data-unit-id');

      if (targetUnit) {
        try {
          sessionStorage.setItem('alfuad_selected_unit', targetUnit);
        } catch {
          // Abaikan apabila storage dibatasi
        }

        const unitSelect = document.querySelector<HTMLSelectElement>('[data-ppdb-unit-select]');
        if (unitSelect) {
          const matchingOption = Array.from(unitSelect.options).find(
            (opt) => opt.value === targetUnit,
          );
          if (matchingOption) {
            unitSelect.value = targetUnit;
            unitSelect.dispatchEvent(new Event('change', { bubbles: true }));
          }
        }

        window.dispatchEvent(
          new CustomEvent('ppdb:select-unit', {
            detail: { unit: targetUnit, unitId: targetUnitId },
          }),
        );

        const formSection =
          document.getElementById('daftar-ppdb') ||
          document.getElementById('ppdb-form');
        if (formSection) {
          event.preventDefault();
          formSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
          if (window.location.hash !== '#daftar-ppdb') {
            history.replaceState(null, '', '#daftar-ppdb');
          }
          const targetSelect =
            document.getElementById('ppdb-targetUnit') ||
            formSection.querySelector('select, input');
          if (targetSelect instanceof HTMLElement) {
            setTimeout(() => targetSelect.focus({ preventScroll: true }), 450);
          }
        }
      }
    });
  });
</script>
