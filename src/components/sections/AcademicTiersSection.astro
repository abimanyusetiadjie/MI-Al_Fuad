---
import { getCollection } from 'astro:content';
import {
  ArrowRight,
  BookOpen,
  CheckCircle2,
  Clock,
  GraduationCap,
  ShieldCheck,
  Sparkles,
} from 'lucide-astro';
import { SITE_CONFIG, type UnitId } from '@/data/siteConfig';
import { PPDB_FEES_BY_UNIT } from '@/data/ppdbData';
import { formatRupiah } from '@/utils/currency';
import type { TARGET_UNIT_OPTIONS } from '@/utils/whatsapp';

type TargetUnitOption = (typeof TARGET_UNIT_OPTIONS)[number];

const UNIT_TO_PPDB_OPTION: Record<UnitId, TargetUnitOption> = {
  ra: 'RA Al-Fuad',
  mit: 'MI TPI Al-Fuad (Setara SD Islam)',
  smpit: 'SMP-IT Al-Fuad',
  smkit: 'SMK-IT Al-Fuad',
  pesantren: 'Pondok Pesantren',
};

const unitsEntries = (await getCollection('units')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<section
  id="jenjang"
  class="scroll-mt-24 py-16 md:py-24 bg-surface-alabaster border-b border-primary-dark/10"
>
  <div class="container-12 gap-y-8">
    <!-- Section Heading -->
    <div class="col-span-12 lg:col-span-8 space-y-4">
      <span
        class="inline-flex items-center gap-2 rounded-full bg-primary-surface px-3.5 py-1.5 text-xs sm:text-sm font-semibold text-primary-dark border border-primary/20"
      >
        <GraduationCap class="h-4 w-4 text-gold shrink-0" aria-hidden="true" />
        <span>5 Jenjang Pendidikan Terpadu &bull; Terdaftar Resmi</span>
      </span>

      <h2
        class="font-heading text-2xl sm:text-3xl lg:text-4xl font-bold text-ink-heading leading-tight"
      >
        Pilihan Jenjang Pendidikan dari Usia Dini hingga Siap Kerja &amp; Pesantren
      </h2>

      <p class="text-base sm:text-lg text-ink-body leading-relaxed">
        Seluruh satuan pendidikan berada terpadu dalam satu kawasan di Poris Gaga,
        Batuceper, sehingga Ayah &amp; Bunda dapat mempercayakan pendidikan
        Ananda secara berkelanjutan dengan legalitas NPSN resmi.
      </p>
    </div>

    <div class="col-span-12 lg:col-span-4 flex lg:items-end lg:justify-end">
      <div
        class="w-full lg:w-auto rounded-2xl bg-white px-4 py-3.5 border border-gold/30 shadow-sm text-xs sm:text-sm text-ink-subheading"
      >
        <p class="font-bold text-primary-dark">
          Bisa Lanjut Berjenjang Satu Yayasan
        </p>
        <p class="mt-0.5 text-ink-body">
          Tersedia potongan khusus alumni MIT Al-Fuad &amp; saudara kandung.
        </p>
      </div>
    </div>

    <!-- 5 Kartu Unit Pendidikan (3 kartu atas lg:col-span-4, 2 kartu bawah lg:col-span-6) -->
    {
      unitsEntries.map((unit, index) => {
        const unitMeta = SITE_CONFIG.units.find((item) => item.id === unit.data.unitId);
        const unitFee = PPDB_FEES_BY_UNIT.find((item) => item.unitId === unit.data.unitId);
        const ppdbOptionValue = UNIT_TO_PPDB_OPTION[unit.data.unitId];
        const colClass =
          index < 3
            ? 'col-span-12 md:col-span-6 lg:col-span-4'
            : 'col-span-12 md:col-span-6 lg:col-span-6';
        const isPrimaryFocus = unit.data.unitId === 'mit';

        return (
          <article
            class={`${colClass} rounded-3xl bg-white p-6 sm:p-7 border ${
              isPrimaryFocus
                ? 'border-gold/50 ring-1 ring-gold/25 shadow-md'
                : 'border-primary-dark/12 shadow-sm'
            } hover:shadow-lg transition-all flex flex-col justify-between gap-6`}
          >
            <div class="space-y-5">
              <!-- Baris Badge NPSN & Status -->
              <div class="flex flex-wrap items-center justify-between gap-2">
                <span class="inline-flex items-center gap-1.5 rounded-lg bg-primary-dark px-3 py-1 font-mono text-xs font-bold text-gold-light">
                  <ShieldCheck class="h-3.5 w-3.5 text-gold-medium shrink-0" aria-hidden="true" />
                  <span>
                    {unit.data.npsn === 'Terdaftar Kemenag'
                      ? 'Terdaftar Resmi Kemenag'
                      : `NPSN: ${unit.data.npsn}`}
                  </span>
                </span>

                <span class="inline-flex items-center rounded-full bg-primary-surface px-2.5 py-1 text-xs font-semibold text-primary-dark border border-primary/15">
                  {unit.data.accreditation}
                </span>
              </div>

              <!-- Judul & Deskripsi Jenjang -->
              <div class="space-y-1.5">
                <p class="text-xs font-bold uppercase tracking-wide text-amber-700">
                  {unitMeta?.levelLabel ?? ''}
                </p>
                <h3 class="font-heading text-xl sm:text-2xl font-bold text-ink-heading">
                  {unit.data.title}
                </h3>
                <p class="text-sm text-ink-body leading-relaxed">
                  {unitMeta?.shortDesc ?? ''}
                </p>
              </div>

              <!-- Target Lulusan & Capaian Hafalan -->
              <div class="rounded-2xl bg-primary-surface/75 p-4 border border-primary/15 space-y-1.5">
                <p class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-primary-dark">
                  <BookOpen class="h-3.5 w-3.5 text-primary shrink-0" aria-hidden="true" />
                  <span>Target Lulusan &amp; Capaian Hafalan</span>
                </p>
                <p class="text-sm font-bold text-ink-heading leading-snug">
                  {unit.data.tahfidzTarget}
                </p>
              </div>

              <!-- Highlight Kurikulum -->
              <div class="space-y-2.5">
                <p class="text-xs font-bold uppercase tracking-wider text-ink-subheading">
                  Highlight Kurikulum &amp; Pembinaan
                </p>
                <ul class="space-y-2 text-sm text-ink-body">
                  {unit.data.curriculumHighlights.slice(0, 3).map((highlight) => (
                    <li class="flex items-start gap-2">
                      <CheckCircle2
                        class="h-4 w-4 text-primary shrink-0 mt-0.5"
                        aria-hidden="true"
                      />
                      <span>{highlight}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Ekstrakurikuler Unggulan -->
              <div class="space-y-2">
                <p class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-ink-subheading">
                  <Sparkles class="h-3.5 w-3.5 text-gold shrink-0" aria-hidden="true" />
                  <span>Ekstrakurikuler Unggulan</span>
                </p>
                <div class="flex flex-wrap gap-1.5">
                  {unit.data.extracurriculars.map((ekskul) => (
                    <span class="inline-flex items-center rounded-lg bg-surface-cream px-2.5 py-1 text-xs font-medium text-ink-subheading border border-primary-dark/10">
                      {ekskul}
                    </span>
                  ))}
                </div>
              </div>
            </div>

            <!-- Footer Kartu: Jam Belajar, Info Kuota/SPP Singkat & Tombol Pilih Jenjang -->
            <div class="space-y-3.5 pt-4 border-t border-primary-dark/10">
              <div class="flex flex-wrap items-center justify-between gap-2 text-xs text-ink-caption">
                <span class="inline-flex items-center gap-1.5 font-medium text-ink-subheading">
                  <Clock class="h-3.5 w-3.5 text-primary shrink-0" aria-hidden="true" />
                  <span>{unit.data.studyHours}</span>
                </span>
                {unitFee && (
                  <span class="font-semibold text-primary-dark">
                    SPP mulai {formatRupiah(unitFee.monthlyTuition)}/bln
                  </span>
                )}
              </div>

              <a
                href="#daftar-ppdb"
                data-select-unit={ppdbOptionValue}
                data-unit-id={unit.data.unitId}
                class={`inline-flex w-full items-center justify-center gap-2 min-h-[48px] rounded-xl px-4 py-3 text-sm font-bold transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 ${
                  isPrimaryFocus
                    ? 'bg-amber-700 hover:bg-amber-800 text-white shadow-sm focus-visible:outline-amber-700'
                    : 'bg-primary hover:bg-primary-dark text-white shadow-sm focus-visible:outline-primary'
                }`}
              >
                <span>Pilih Jenjang Ini untuk Daftar</span>
                <ArrowRight class="h-4 w-4 shrink-0" aria-hidden="true" />
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<script is:inline>
  (function () {
    const unitButtons = document.querySelectorAll('[data-select-unit]');
    if (!unitButtons.length) return;

    unitButtons.forEach((button) => {
      button.addEventListener('click', (event) => {
        const targetUnit = button.getAttribute('data-select-unit');
        const unitId = button.getAttribute('data-unit-id');
        if (!targetUnit) return;

        window.__selectedPpdbUnit = targetUnit;
        try {
          sessionStorage.setItem('ypi_selected_ppdb_unit', targetUnit);
        } catch (_err) {
          // Abaikan jika sessionStorage dibatasi
        }

        const selectElement =
          document.querySelector('[data-ppdb-unit-select]') ||
          document.querySelector('select[name="targetUnit"]');

        if (selectElement instanceof HTMLSelectElement) {
          selectElement.value = targetUnit;
          selectElement.dispatchEvent(new Event('change', { bubbles: true }));
        }

        window.dispatchEvent(
          new CustomEvent('ppdb:select-unit', {
            detail: { unit: targetUnit, unitId },
          }),
        );

        const formSection =
          document.getElementById('daftar-ppdb') ||
          document.getElementById('ppdb-form') ||
          document.getElementById('biaya-ppdb');
        if (formSection) {
          event.preventDefault();
          formSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
          if (window.location.hash !== '#daftar-ppdb') {
            history.replaceState(null, '', '#daftar-ppdb');
          }
          const targetSelect =
            document.getElementById('ppdb-targetUnit') ||
            formSection.querySelector('select, input');
          if (targetSelect instanceof HTMLElement) {
            setTimeout(() => targetSelect.focus({ preventScroll: true }), 450);
          }
        }
      });
    });
  })();
</script>
