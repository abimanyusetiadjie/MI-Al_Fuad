---
import { getCollection } from 'astro:content';
import { ArrowRight, Clock, ShieldCheck } from 'lucide-astro';
import { SITE_CONFIG, type UnitId } from '@/data/siteConfig';
import { PPDB_FEES_BY_UNIT } from '@/data/ppdbData';
import { formatRupiah } from '@/utils/currency';
import type { TARGET_UNIT_OPTIONS } from '@/utils/whatsapp';

type TargetUnitOption = (typeof TARGET_UNIT_OPTIONS)[number];

const UNIT_TO_PPDB_OPTION: Record<UnitId, TargetUnitOption> = {
  ra: 'RA Al-Fuad',
  mit: 'MI TPI Al-Fuad (Setara SD Islam)',
  smpit: 'SMP-IT Al-Fuad',
  smkit: 'SMK-IT Al-Fuad',
  pesantren: 'Pondok Pesantren',
};

const unitsEntries = (await getCollection('units')).sort(
  (a, b) => a.data.order - b.data.order,
);

const flagshipUnit = unitsEntries.find((u) => u.data.unitId === 'mit');
const otherUnits = unitsEntries.filter((u) => u.data.unitId !== 'mit');
---

<section
  id="jenjang"
  class="scroll-mt-24 py-14 md:py-20 bg-white border-b border-stone-200/80"
>
  <div class="container-12 gap-y-6 md:gap-y-8">
    <!-- Section Heading -->
    <div class="col-span-12 flex flex-col md:flex-row md:items-end justify-between gap-4" data-reveal>
      <div class="space-y-2 max-w-2xl">
        <p class="text-xs font-bold uppercase tracking-wider text-amber-700">
          5 Unit Pendidikan Terpadu
        </p>
        <h2 class="font-heading text-2xl sm:text-3xl lg:text-4xl font-bold text-ink-heading tracking-tight">
          Satu Kawasan Aman Dari Usia Dini Hingga SMK.
        </h2>
      </div>
      <p class="text-sm text-ink-body max-w-sm">
        Pilih jenjang tujuan untuk mengisi formulir PPDB secara otomatis.
      </p>
    </div>

    <!-- Flagship Card: MI TPI Al-Fuad (Setara SD Islam) -->
    {
      flagshipUnit && (() => {
        const unitMeta = SITE_CONFIG.units.find((u) => u.id === 'mit');
        const feeInfo = PPDB_FEES_BY_UNIT.find((f) => f.unitId === 'mit');
        const ppdbOptionValue = UNIT_TO_PPDB_OPTION.mit;

        return (
          <article class="col-span-12 rounded-2xl border border-primary/25 bg-primary-surface/40 p-6 sm:p-8 grid grid-cols-12 gap-6 items-center">
            <div class="col-span-12 lg:col-span-8 space-y-4">
              <div class="flex flex-wrap items-center gap-2">
                <span class="rounded-full bg-primary-dark px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-gold-light">
                  Unggulan Utama
                </span>
                <span class="inline-flex items-center gap-1 rounded-md bg-white px-2.5 py-1 font-mono text-xs font-bold text-primary-dark border border-primary/15">
                  <ShieldCheck class="h-3.5 w-3.5 text-primary" aria-hidden="true" />
                  NPSN {flagshipUnit.data.npsn}
                </span>
                <span class="text-xs font-semibold text-amber-700">
                  {unitMeta?.levelLabel}
                </span>
              </div>

              <div class="space-y-1.5">
                <h3 class="font-heading text-xl sm:text-2xl font-extrabold text-ink-heading">
                  {flagshipUnit.data.title}
                </h3>
                <p class="text-sm text-ink-body leading-relaxed max-w-2xl">
                  Target: <strong class="font-semibold text-primary-dark">{flagshipUnit.data.tahfidzTarget}</strong> &bull;
                  Bimbingan mengaji dari nol terintegrasi kurikulum Kemenag.
                </p>
              </div>

              <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-xs font-medium text-ink-subheading">
                <span class="inline-flex items-center gap-1.5">
                  <Clock class="h-3.5 w-3.5 text-primary" aria-hidden="true" />
                  {flagshipUnit.data.studyHours}
                </span>
                {feeInfo && (
                  <span>
                    SPP Bulanan: <strong class="text-ink-heading">{formatRupiah(feeInfo.monthlyTuition)}</strong>
                  </span>
                )}
              </div>

              <!-- Detail Kurikulum & Ekskul (Expandable, Bebas Wall of Text) -->
              <details class="group pt-1">
                <summary class="inline-flex cursor-pointer list-none items-center gap-1.5 text-xs font-bold text-primary-dark hover:underline [&::-webkit-details-marker]:hidden">
                  <span>Lihat kurikulum &amp; ekstrakurikuler</span>
                  <span aria-hidden="true" class="transition-transform group-open:rotate-90">&rsaquo;</span>
                </summary>
                <div class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-3 rounded-xl bg-white p-4 border border-primary/15 text-xs text-ink-body">
                  <div>
                    <p class="font-bold text-ink-heading mb-1">Fokus Kurikulum:</p>
                    <ul class="space-y-1 list-disc list-inside">
                      {flagshipUnit.data.curriculumHighlights.slice(0, 3).map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </div>
                  <div>
                    <p class="font-bold text-ink-heading mb-1">Ekstrakurikuler:</p>
                    <p>{flagshipUnit.data.extracurriculars.join(' · ')}</p>
                  </div>
                </div>
              </details>
            </div>

            <div class="col-span-12 lg:col-span-4 flex flex-col sm:flex-row lg:flex-col items-stretch sm:items-center lg:items-end justify-between gap-3 lg:border-l lg:border-primary/15 lg:pl-6">
              {feeInfo && (
                <div class="lg:text-right">
                  <span class="inline-block rounded-full bg-gold-light px-2.5 py-0.5 text-[11px] font-bold text-amber-800">
                    {feeInfo.quotaStatus} ({feeInfo.quotaRemaining} kursi)
                  </span>
                  <p class="mt-1.5 text-xs text-ink-caption">Estimasi Masuk Awal</p>
                  <p class="font-heading text-lg font-extrabold text-primary-dark">
                    {formatRupiah(feeInfo.totalEstimatedInitial)}
                  </p>
                </div>
              )}

              <a
                href="#daftar-ppdb"
                data-select-unit={ppdbOptionValue}
                data-unit-id="mit"
                class="inline-flex items-center justify-center gap-2 min-h-[48px] rounded-xl bg-amber-700 hover:bg-amber-800 px-5 py-3 text-sm font-semibold text-white transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700"
              >
                <span>Pilih &amp; Daftar MI TPI</span>
                <ArrowRight class="h-4 w-4 shrink-0" aria-hidden="true" />
              </a>
            </div>
          </article>
        );
      })()
    }

    <!-- 4 Unit Lainnya (Grid 2x2 Desktop & Tablet, Ringkas di Mobile) -->
    {
      otherUnits.map((unit) => {
        const unitMeta = SITE_CONFIG.units.find((u) => u.id === unit.data.unitId);
        const feeInfo = PPDB_FEES_BY_UNIT.find((f) => f.unitId === unit.data.unitId);
        const ppdbOptionValue = UNIT_TO_PPDB_OPTION[unit.data.unitId];

        return (
          <article data-reveal class="card-elevate col-span-12 md:col-span-6 rounded-2xl bg-[#FAF8F5] border border-stone-200/90 p-5 sm:p-6 flex flex-col justify-between gap-4">
            <div class="space-y-3">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <span class="text-xs font-bold uppercase tracking-wide text-amber-700">
                  {unitMeta?.levelLabel ?? ''}
                </span>
                <span class="rounded-md bg-white px-2 py-0.5 font-mono text-[11px] font-bold text-primary-dark border border-stone-200">
                  {unit.data.npsn === 'Terdaftar Kemenag' ? 'Kemenag RI' : `NPSN ${unit.data.npsn}`}
                </span>
              </div>

              <div class="space-y-1">
                <h3 class="font-heading text-lg sm:text-xl font-bold text-ink-heading">
                  {unit.data.title}
                </h3>
                <p class="text-xs sm:text-sm text-ink-body line-clamp-2">
                  Target: <strong class="font-semibold text-ink-heading">{unit.data.tahfidzTarget}</strong>
                </p>
              </div>

              <p class="inline-flex items-center gap-1.5 text-xs text-ink-caption">
                <Clock class="h-3.5 w-3.5 text-primary shrink-0" aria-hidden="true" />
                <span>{unit.data.studyHours}</span>
              </p>

              <details class="group">
                <summary class="inline-flex cursor-pointer list-none items-center gap-1 text-xs font-semibold text-primary hover:underline [&::-webkit-details-marker]:hidden">
                  <span>Kurikulum &amp; Ekskul</span>
                  <span aria-hidden="true" class="transition-transform group-open:rotate-90">&rsaquo;</span>
                </summary>
                <ul class="mt-2.5 space-y-1 rounded-xl bg-white p-3.5 border border-stone-200 text-xs text-ink-body list-disc list-inside">
                  {unit.data.curriculumHighlights.slice(0, 3).map((highlight) => (
                    <li>{highlight}</li>
                  ))}
                  <li class="list-none pt-1 font-medium text-ink-heading">
                    Ekskul: {unit.data.extracurriculars.join(' · ')}
                  </li>
                </ul>
              </details>
            </div>

            <div class="pt-3 border-t border-stone-200/80 flex items-center justify-between gap-3">
              {feeInfo && (
                <div>
                  <p class="text-[11px] text-ink-caption">
                    SPP {formatRupiah(feeInfo.monthlyTuition)}/bln
                  </p>
                  <p class="text-xs font-bold text-primary-dark">
                    {feeInfo.quotaStatus} ({feeInfo.quotaRemaining} kursi)
                  </p>
                </div>
              )}

              <a
                href="#daftar-ppdb"
                data-select-unit={ppdbOptionValue}
                data-unit-id={unit.data.unitId}
                class="inline-flex items-center justify-center gap-1.5 min-h-[44px] rounded-xl bg-primary hover:bg-primary-dark px-4 py-2 text-xs sm:text-sm font-semibold text-white transition-colors shrink-0"
              >
                <span>Pilih &amp; Daftar</span>
                <ArrowRight class="h-3.5 w-3.5 shrink-0" aria-hidden="true" />
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<script>
  const unitButtons = document.querySelectorAll('[data-select-unit]');

  unitButtons.forEach((button) => {
    button.addEventListener('click', (event) => {
      const targetUnit = button.getAttribute('data-select-unit');
      const targetUnitId = button.getAttribute('data-unit-id');

      if (targetUnit) {
        try {
          sessionStorage.setItem('alfuad_selected_unit', targetUnit);
        } catch {
          // Abaikan apabila storage dibatasi
        }

        const unitSelect = document.querySelector<HTMLSelectElement>('[data-ppdb-unit-select]');
        if (unitSelect) {
          const matchingOption = Array.from(unitSelect.options).find(
            (opt) => opt.value === targetUnit,
          );
          if (matchingOption) {
            unitSelect.value = targetUnit;
            unitSelect.dispatchEvent(new Event('change', { bubbles: true }));
          }
        }

        window.dispatchEvent(
          new CustomEvent('ppdb:select-unit', {
            detail: { unit: targetUnit, unitId: targetUnitId },
          }),
        );

        const formSection =
          document.getElementById('daftar-ppdb') ||
          document.getElementById('ppdb-form') ||
          document.getElementById('biaya-ppdb');
        if (formSection) {
          event.preventDefault();
          formSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
          if (window.location.hash !== '#daftar-ppdb') {
            history.replaceState(null, '', '#daftar-ppdb');
          }
          const targetSelect =
            document.getElementById('ppdb-targetUnit') ||
            formSection.querySelector('select, input');
          if (targetSelect instanceof HTMLElement) {
            setTimeout(() => targetSelect.focus({ preventScroll: true }), 450);
          }
        }
      }
    });
  });
</script>
