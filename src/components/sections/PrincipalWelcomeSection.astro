---
import { Image } from 'astro:assets';
import masjidImg from '@/assets/galeri/masjid-at-taqwa.webp';
import { SITE_CONFIG } from '@/data/siteConfig';
---

<!-- Section 3 (Editorial Divider): Pill Emas + Heading 2-Gaya (Adaptasi Mutiara Bangsa) -->
<section class="pt-4 pb-12 md:pt-6 md:pb-16 bg-white text-center">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 space-y-3" data-reveal>
    <span class="inline-block rounded-full bg-gold-light px-4 py-1 text-xs font-bold text-status-warningText border border-gold/30">
      Berdiri Sejak {SITE_CONFIG.foundedYear} &bull; Mengaji Dari Nol
    </span>
    <h2 class="font-heading text-2xl sm:text-4xl font-light text-primary-dark tracking-tight leading-snug">
      Setiap Ananda Dibina{' '}
      <strong class="block sm:inline font-extrabold">Menemukan Cahaya Al-Qur'an</strong>
    </h2>
  </div>
</section>

<!-- Section 4 (#visi-misi & #sambutan): Full-Width Emerald Photo-Overlay Banner (Visi | Misi) -->
<section
  id="visi-misi"
  class="scroll-mt-24 relative overflow-hidden bg-primary-dark text-white py-14 md:py-20"
>
  <span id="sambutan" class="scroll-mt-24 sr-only" aria-hidden="true"></span>

  <!-- Foto Latar Kampus / Masjid -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <Image
      src={masjidImg}
      alt=""
      class="h-full w-full object-cover opacity-25"
      loading="lazy"
      decoding="async"
    />
    <div class="absolute inset-0 bg-primary-dark/85"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 space-y-8" data-reveal>
    <!-- Mobile Stacked Tanpa Garis Horizontal Tengah, Desktop 2-Kolom dengan Garis Vertikal (Persis Mutiara Bangsa) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-0 md:divide-x divide-white/25 text-center md:text-left">
      <div class="md:pr-10 space-y-2.5 sm:space-y-3">
        <h3 class="font-heading text-2xl sm:text-3xl font-extrabold text-gold-medium">
          Visi Kami
        </h3>
        <p class="text-sm sm:text-base text-emerald-50/90 leading-relaxed">
          Mencetak generasi Qur'ani yang hafal serta memahami makna Al-Qur'an, beradab mulia kepada orang tua dan guru, serta unggul secara akademik sejak usia dini.
        </p>
      </div>

      <div class="md:pl-10 space-y-2.5 sm:space-y-3">
        <h3 class="font-heading text-2xl sm:text-3xl font-extrabold text-gold-medium">
          Misi Kami
        </h3>
        <p class="text-sm sm:text-base text-emerald-50/90 leading-relaxed">
          Membimbing setiap siswa mengaji dari nol bersama 52+ asatidz hafidz, mewajibkan hafalan dan terjemah Juz 30, serta menjaga lingkungan sekolah terpadu yang aman dan Islami.
        </p>
      </div>
    </div>

    <!-- Kutipan Singkat & Atribusi Pengasuh -->
    <div class="pt-6 border-t border-white/15 flex flex-col sm:flex-row items-center justify-between gap-3 text-center sm:text-left">
      <p class="text-xs sm:text-sm text-emerald-100/85 italic">
        “Mendidik dengan hati, membiasakan adab, dan menjaga Al-Qur'an bersama keluarga.”
      </p>
      <p class="text-xs font-bold text-gold-light shrink-0">
        {SITE_CONFIG.chairman} &bull; Pengasuh YPI Al-Fuad
      </p>
    </div>
  </div>
</section>
