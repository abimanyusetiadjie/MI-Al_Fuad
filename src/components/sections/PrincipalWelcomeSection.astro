---
import { Image } from 'astro:assets';
import { Quote } from 'lucide-astro';
import masjidAtTaqwaImg from '@/assets/galeri/masjid-at-taqwa.webp';
import { SITE_CONFIG } from '@/data/siteConfig';

interface AnimatedCounter {
  target: number;
  suffix: string;
  label: string;
}

const counters: readonly AnimatedCounter[] = [
  { target: 35, suffix: '+', label: 'Tahun Mengabdi' },
  { target: 52, suffix: '+', label: 'Guru Hafidz' },
  { target: 30, suffix: ' Juz', label: 'Wajib Juz 30 & Arti' },
  { target: 5, suffix: ' Unit', label: 'Jenjang Terpadu' },
] as const;
---

<section
  id="sambutan"
  class="scroll-mt-24 py-12 md:py-16 bg-white border-b border-stone-200/80"
>
  <div class="container-12 items-center gap-y-8 md:gap-y-10">
    <!-- Kolom Kiri (5 Kolom): Kartu Visual Kampus & Pimpinan (Adaptasi Principal's Welcome) -->
    <div class="col-span-12 lg:col-span-5" data-reveal>
      <div class="relative overflow-hidden rounded-2xl border border-stone-200 bg-[#FAF8F5] p-2 shadow-sm">
        <Image
          src={masjidAtTaqwaImg}
          alt="Masjid Jami' At-Taqwa pusat pembinaan ibadah dan tahfidz YPI Al-Fuad Poris Gaga"
          class="w-full h-auto aspect-[16/10] rounded-xl object-cover"
          loading="lazy"
          decoding="async"
        />
        <div class="p-4 flex items-center justify-between gap-3">
          <div>
            <p class="font-heading text-sm font-bold text-primary-dark">
              {SITE_CONFIG.chairman}
            </p>
            <p class="text-xs text-ink-caption">
              Ketua &amp; Pengasuh YPI Al-Fuad &bull; Sejak {SITE_CONFIG.foundedYear}
            </p>
          </div>
          <span class="shrink-0 rounded-full bg-gold-light px-2.5 py-1 text-[11px] font-bold text-amber-800">
            Poris Gaga
          </span>
        </div>
      </div>
    </div>

    <!-- Kolom Kanan (7 Kolom): Sambutan Ringkas & Counter Statistik Beranimasi -->
    <div class="col-span-12 lg:col-span-7 space-y-6" data-reveal data-reveal-delay="90">
      <div class="space-y-3">
        <p class="text-xs font-bold uppercase tracking-wider text-amber-700 inline-flex items-center gap-1.5">
          <Quote class="h-3.5 w-3.5 shrink-0" aria-hidden="true" />
          <span>Sambutan Pengasuh Yayasan</span>
        </p>

        <h2 class="font-heading text-2xl sm:text-3xl font-bold text-ink-heading tracking-tight">
          “Mendidik dengan hati, membiasakan adab, dan mencintai Al-Qur’an sejak dini.”
        </h2>

        <p class="text-sm sm:text-base text-ink-body leading-relaxed max-w-2xl">
          Sejak 1990, kami mendampingi keluarga Muslim di Poris dan Tangerang agar Ananda tumbuh berakhlak mulia tanpa takut tertinggal membaca Al-Qur’an—dibimbing sabar dari nol oleh dewan guru hafidz.
        </p>
      </div>

      <!-- 4 Counter Statistik Beranimasi (EaseOutExpo saat di-scroll) -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-5 border-t border-stone-200/90">
        {
          counters.map((item) => (
            <div class="rounded-xl bg-white p-3.5 border border-stone-200/80 card-elevate">
              <p
                class="font-heading text-xl sm:text-2xl font-extrabold tracking-tight text-primary-dark tabular-nums"
                data-counter-target={item.target}
                data-counter-suffix={item.suffix}
              >
                {item.target}
                {item.suffix}
              </p>
              <p class="mt-0.5 text-xs font-medium text-ink-caption">
                {item.label}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
