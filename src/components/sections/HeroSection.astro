---
import { Image } from 'astro:assets';
import { ArrowRight, MessageCircle } from 'lucide-astro';
import heroMiImg from '@/assets/hero-mi-alfuad.webp';
---

<!-- Opsi B: Full-Bleed Cinematic Editorial Hero (Foto Jernih Alami + Directional Scrim Presisi) -->
<section
  id="tentang"
  class="scroll-mt-24 relative overflow-hidden bg-primary-dark text-white min-h-[570px] sm:min-h-[600px] lg:min-h-[540px] flex flex-col justify-end lg:justify-center pt-56 pb-12 sm:pt-64 sm:pb-16 lg:pt-20 lg:pb-28"
>
  <!-- Full-Bleed Photography Layer (Fokus pada Wajah Santri & Ustadzah di Atas/Kanan) -->
  <div class="pointer-events-none absolute inset-x-0 top-0 h-[68%] sm:h-[70%] lg:inset-0 lg:h-full" aria-hidden="true">
    <Image
      src={heroMiImg}
      alt="Suasana belajar Al-Qur'an siswa MI TPI Al-Fuad Poris Gaga bersama Ustadzah di ruang kelas terang"
      class="h-full w-full object-cover object-[76%_center] lg:object-[72%_center]"
      loading="eager"
      fetchpriority="high"
    />

    <!-- Scrim Mobile/Tablet (Bottom-Up): Bagian Atas Foto Cerah Alami, Bagian Bawah Kontras Tajam -->
    <div
      class="lg:hidden absolute inset-0 bg-gradient-to-t from-primary-dark via-primary-dark/65 via-[32%] to-transparent"
    >
    </div>

    <!-- Scrim Desktop (Left-to-Right): Sisi Kiri Tegas untuk Teks, Sisi Kanan Foto Terbuka Terang -->
    <div
      class="hidden lg:block absolute inset-0 bg-gradient-to-r from-primary-dark via-primary-dark/85 via-[45%] to-transparent"
    >
    </div>
    <div
      class="hidden lg:block absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-primary-dark/80 to-transparent"
    >
    </div>
  </div>

  <!-- Foreground Editorial Content -->
  <div class="relative z-10 w-full mx-auto max-w-[1280px] px-4 sm:px-6 lg:px-8">
    <div class="max-w-lg lg:max-w-xl space-y-3.5 sm:space-y-4 animate-hero-in">
      <p class="text-[10.5px] sm:text-xs font-bold uppercase tracking-[0.16em] text-gold-light">
        Poris Gaga, Tangerang &bull; Sejak 1990
      </p>

      <h1 class="font-heading text-[1.7rem] sm:text-4xl lg:text-[3.2rem] font-extrabold text-white leading-[1.13] tracking-tight drop-shadow-sm">
        Generasi Qur'ani,{' '}
        <span class="text-gold underline decoration-gold/50 decoration-2 underline-offset-4">
          Hafal &amp; Paham
        </span>{' '}
        <span class="whitespace-nowrap">Al-Qur'an.</span>
      </h1>

      <p class="max-w-md text-sm sm:text-base text-emerald-50/95 leading-relaxed">
        Madrasah Ibtidaiyah TPI Al-Fuad &amp; sekolah Islam terpadu (RA hingga SMK-IT &amp; Pondok) dengan bimbingan mengaji sabar dari nol.
      </p>

      <div class="flex flex-wrap items-center gap-x-4 sm:gap-x-5 gap-y-2 pt-1">
        <a
          href="#daftar-ppdb"
          class="inline-flex items-center justify-center gap-2 min-h-[46px] sm:min-h-[48px] rounded-xl bg-gold hover:bg-gold-hover px-4 sm:px-6 py-2.5 sm:py-3 text-[13px] sm:text-base font-bold text-ink-heading shadow-lg transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold-light"
        >
          <MessageCircle class="h-4 w-4 shrink-0" aria-hidden="true" />
          <span>Daftar PPDB</span>
        </a>

        <a
          href="#jenjang"
          class="group inline-flex items-center gap-1.5 min-h-[46px] sm:min-h-[48px] px-1 text-[13px] sm:text-base font-semibold text-white hover:text-gold-light transition-colors whitespace-nowrap"
        >
          <span>Lihat Unit &amp; Biaya</span>
          <ArrowRight class="h-4 w-4 shrink-0 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
        </a>
      </div>
    </div>
  </div>
</section>
