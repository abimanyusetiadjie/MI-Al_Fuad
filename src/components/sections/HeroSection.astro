---
import { Image } from 'astro:assets';
import { ArrowRight, Award, MessageCircle } from 'lucide-astro';
import heroMiImg from '@/assets/hero-mi-alfuad.webp';
---

<section
  id="tentang"
  class="scroll-mt-24 relative overflow-hidden bg-primary-dark text-white pt-10 pb-16 md:pt-16 md:pb-24"
>
  <!-- Ambient Glow Halus -->
  <div
    class="pointer-events-none absolute inset-0 opacity-25"
    aria-hidden="true"
  >
    <div
      class="absolute -top-28 -right-24 h-80 w-80 rounded-full bg-primary-light blur-3xl"
    >
    </div>
    <div
      class="absolute -bottom-28 -left-24 h-72 w-72 rounded-full bg-gold blur-3xl opacity-60"
    >
    </div>
  </div>

  <!-- Info Ticker Pengumuman PPDB (Khas Portal Sekolah Indonesia) -->
  <div class="relative container-12 mb-6 md:mb-8">
    <div class="col-span-12">
      <a
        href="#biaya-ppdb"
        class="inline-flex items-center gap-2.5 rounded-full border border-white/15 bg-white/10 hover:bg-white/15 px-3.5 py-1.5 text-[11px] sm:text-xs font-medium text-emerald-50 transition-colors"
      >
        <span class="relative flex h-2 w-2 shrink-0" aria-hidden="true">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-gold-medium opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-gold-medium"></span>
        </span>
        <span>
          <strong class="font-bold text-gold-light">Info PPDB:</strong> Gelombang Dini &amp; Gelombang 1 Dibuka &bull; Potongan Uang Pangkal s/d Rp 500rb &rarr;
        </span>
      </a>
    </div>
  </div>

  <div class="relative container-12 items-center gap-y-8 md:gap-y-10">
    <!-- Kolom Kiri (6 Kolom Desktop): Editorial Typography & CTA -->
    <div class="col-span-12 lg:col-span-6 space-y-5 md:space-y-6 animate-hero-in">
      <h1
        class="font-heading text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white leading-[1.12] tracking-tight"
      >
        Generasi Qur'ani: <span class="text-gold-medium">Hafal &amp; Paham</span> Al-Qur'an Sejak Dini.
      </h1>

      <p class="text-base sm:text-lg text-emerald-50/85 leading-relaxed max-w-xl">
        MI TPI Al-Fuad (Setara SD Islam) &amp; sekolah Islam terpadu di Poris Gaga sejak 1990.
        Membimbing Ananda mengaji dari nol hingga wajib hafal &amp; paham Juz 30.
      </p>

      <!-- Dual CTA -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-1">
        <a
          href="#daftar-ppdb"
          class="inline-flex items-center justify-center gap-2 min-h-[48px] rounded-xl bg-amber-700 hover:bg-amber-800 px-6 py-3 text-sm sm:text-base font-semibold text-white shadow-lg shadow-emerald-950/30 transition-all hover:-translate-y-0.5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold-light"
        >
          <MessageCircle class="h-4 w-4 shrink-0" aria-hidden="true" />
          <span>Daftar PPDB Sekarang</span>
        </a>

        <a
          href="#biaya-ppdb"
          class="inline-flex items-center justify-center gap-2 min-h-[48px] rounded-xl border border-white/25 bg-white/5 hover:bg-white/15 px-6 py-3 text-sm sm:text-base font-medium text-white transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
        >
          <span>Cek Biaya &amp; Jenjang</span>
          <ArrowRight class="h-4 w-4 shrink-0" aria-hidden="true" />
        </a>
      </div>

      <ul class="pt-1 text-xs sm:text-sm text-emerald-100/80 flex flex-wrap items-center gap-x-4 gap-y-1.5">
        <li class="inline-flex items-center gap-1.5">
          <span class="h-1 w-1 rounded-full bg-gold-medium" aria-hidden="true"></span>
          <span>Mengaji dari nol</span>
        </li>
        <li class="inline-flex items-center gap-1.5">
          <span class="h-1 w-1 rounded-full bg-gold-medium" aria-hidden="true"></span>
          <span>52+ Guru Hafidz</span>
        </li>
        <li class="inline-flex items-center gap-1.5">
          <span class="h-1 w-1 rounded-full bg-gold-medium" aria-hidden="true"></span>
          <span>NPSN Resmi Kemenag</span>
        </li>
      </ul>
    </div>

    <!-- Kolom Kanan (6 Kolom Desktop): Foto Editorial Kampus -->
    <div class="col-span-12 lg:col-span-6 animate-hero-in-delay">
      <div class="relative rounded-2xl overflow-hidden bg-white/10 p-2 ring-1 ring-white/20 shadow-2xl">
        <Image
          src={heroMiImg}
          alt="Santri dan siswi MI TPI Al-Fuad Poris Gaga belajar Al-Qur'an bersama Ustadzah di kelas"
          class="w-full h-auto aspect-[16/10] rounded-xl object-cover"
          loading="eager"
          fetchpriority="high"
        />

        <div
          class="mt-2 sm:mt-0 sm:absolute sm:bottom-5 sm:left-5 rounded-xl bg-white/95 backdrop-blur-md px-3.5 py-2 text-ink-heading shadow-lg border border-stone-200/80 inline-flex items-center gap-2.5"
        >
          <span
            class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-amber-700 text-white"
            aria-hidden="true"
          >
            <Award class="h-4 w-4" />
          </span>
          <span class="text-xs font-bold text-primary-dark">
            Target Wajib: Hafal &amp; Paham Arti Juz 30
          </span>
        </div>
      </div>
    </div>
  </div>
</section>
