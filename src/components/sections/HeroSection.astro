---
import { Image } from 'astro:assets';
import { ArrowRight, MessageCircle } from 'lucide-astro';
import heroMiImg from '@/assets/hero-mi-alfuad.webp';
import wisudaImg from '@/assets/galeri/wisuda-tahfidz.webp';
import masjidImg from '@/assets/galeri/masjid-at-taqwa.webp';
import kelasImg from '@/assets/galeri/ruang-kelas-mi.webp';
import labImg from '@/assets/galeri/lab-komputer-smkit.webp';
---

<!-- Hero Photo Collage Banner (Adaptasi Penuh Hero Mutiara Bangsa — Tanpa Blank Bug Awal) -->
<section
  id="tentang"
  class="scroll-mt-24 relative overflow-hidden bg-primary-dark text-white"
>
  <!-- Kolase Latar Bento 5 Foto Sekolah (Dimuat Instan) -->
  <div
    class="pointer-events-none absolute inset-0 grid grid-cols-12 gap-2.5 p-2.5 opacity-45"
    aria-hidden="true"
  >
    <div class="col-span-6 md:col-span-4 h-full overflow-hidden rounded-xl">
      <Image
        src={heroMiImg}
        alt=""
        class="h-full w-full object-cover"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="col-span-6 md:col-span-4 h-full grid grid-rows-2 gap-2.5">
      <div class="overflow-hidden rounded-xl">
        <Image src={masjidImg} alt="" class="h-full w-full object-cover" loading="eager" />
      </div>
      <div class="overflow-hidden rounded-xl">
        <Image src={kelasImg} alt="" class="h-full w-full object-cover" loading="eager" />
      </div>
    </div>
    <div class="hidden md:grid md:col-span-4 h-full grid-rows-2 gap-2.5">
      <div class="overflow-hidden rounded-xl">
        <Image src={wisudaImg} alt="" class="h-full w-full object-cover" loading="eager" />
      </div>
      <div class="overflow-hidden rounded-xl">
        <Image src={labImg} alt="" class="h-full w-full object-cover" loading="eager" />
      </div>
    </div>
  </div>

  <!-- Dark Emerald Vignette Overlay agar Teks Sangat Kontras -->
  <div
    class="pointer-events-none absolute inset-0 bg-gradient-to-b from-primary-dark/85 via-primary-dark/75 to-primary-dark/95"
    aria-hidden="true"
  >
  </div>

  <!-- Centered Stacked Typography & Gold Highlight Pill (Selaras Mutiara Bangsa) -->
  <div class="relative z-10 mx-auto max-w-4xl px-4 sm:px-6 pt-14 pb-20 sm:pt-20 sm:pb-28 md:pt-24 md:pb-32 text-center space-y-5">
    <p class="text-sm sm:text-lg font-medium text-emerald-100/95 tracking-wide">
      Selamat Datang di MI TPI &amp; YPI Tahfidz Qur'an Al-Fuad
    </p>

    <h1 class="font-heading text-3xl sm:text-5xl lg:text-[3.5rem] font-extrabold text-white leading-[1.12] tracking-tight">
      Membentuk Generasi Qur'ani
    </h1>

    <div>
      <span class="inline-block rounded-full bg-gold-medium px-6 py-2 sm:px-8 sm:py-2.5 font-heading text-lg sm:text-2xl lg:text-[1.75rem] font-extrabold text-ink-heading shadow-xl">
        Hafal &amp; Paham Al-Qur'an
      </span>
    </div>

    <p class="mx-auto max-w-xl text-xs sm:text-base text-emerald-50/90 leading-relaxed pt-1">
      Pendidikan Islam terpadu di Poris Gaga sejak 1990 (RA, MI TPI setara SD Islam, SMP-IT, SMK-IT &amp; Pondok Pesantren). Membimbing mengaji dari nol.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
      <a
        href="#daftar-ppdb"
        class="inline-flex w-full sm:w-auto items-center justify-center gap-2 min-h-[48px] rounded-xl bg-amber-700 hover:bg-amber-800 px-6 py-3 text-sm sm:text-base font-semibold text-white shadow-lg transition-all hover:-translate-y-0.5"
      >
        <MessageCircle class="h-4 w-4 shrink-0" aria-hidden="true" />
        <span>Daftar PPDB Sekarang</span>
      </a>

      <a
        href="#jenjang"
        class="inline-flex w-full sm:w-auto items-center justify-center gap-2 min-h-[48px] rounded-xl border border-white/30 bg-white/10 hover:bg-white/20 px-6 py-3 text-sm sm:text-base font-medium text-white backdrop-blur-sm transition-colors"
      >
        <span>Lihat Unit &amp; Biaya</span>
        <ArrowRight class="h-4 w-4 shrink-0" aria-hidden="true" />
      </a>
    </div>
  </div>
</section>
