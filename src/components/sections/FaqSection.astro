---
import { ChevronDown, MessageCircle } from 'lucide-astro';
import { PPDB_FAQS } from '@/data/faqData';
import { SITE_CONFIG } from '@/data/siteConfig';
import { buildQuickWhatsAppUrl } from '@/utils/whatsapp';

const quickWaUrl = buildQuickWhatsAppUrl();

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: PPDB_FAQS.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<section
  id="faq"
  class="scroll-mt-24 py-14 md:py-20 bg-white"
>
  <div class="container-12 items-start gap-y-8">
    <!-- Kolom Kiri (4 Kolom Desktop) -->
    <div class="col-span-12 lg:col-span-4 space-y-4" data-reveal>
      <p class="text-xs font-bold uppercase tracking-wider text-amber-700">
        FAQ PPDB
      </p>
      <h2 class="font-heading text-2xl sm:text-3xl font-bold text-ink-heading tracking-tight">
        Pertanyaan Umum Wali Murid.
      </h2>
      <p class="text-sm text-ink-body leading-relaxed">
        Informasi ringkas mengenai mengaji dari nol, cicilan biaya, jam belajar, dan lokasi sekolah.
      </p>

      <div class="pt-1">
        <a
          href={quickWaUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 min-h-[44px] rounded-xl bg-primary hover:bg-primary-dark px-4 py-2.5 text-xs sm:text-sm font-semibold text-white transition-colors"
        >
          <MessageCircle class="h-4 w-4 shrink-0" aria-hidden="true" />
          <span>Tanya Panitia ({SITE_CONFIG.contact.whatsappDisplay})</span>
        </a>
      </div>
    </div>

    <!-- Kolom Kanan (8 Kolom Desktop): Accordion Bersih Hairline -->
    <div class="col-span-12 lg:col-span-8" data-reveal data-reveal-delay="80">
      <div class="divide-y divide-stone-200 border-y border-stone-200 bg-[#FAF8F5] rounded-2xl px-4 sm:px-6 border-x">
        {
          PPDB_FAQS.map((faq, index) => (
            <details class="group py-1" open={index === 0}>
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 min-h-[52px] py-3.5 text-left font-heading text-sm sm:text-base font-bold text-ink-heading hover:text-primary-dark select-none [&::-webkit-details-marker]:hidden">
                <span>{faq.question}</span>
                <ChevronDown
                  class="h-4 w-4 shrink-0 text-ink-caption transition-transform duration-200 group-open:rotate-180 group-open:text-primary"
                  aria-hidden="true"
                />
              </summary>

              <p class="pb-4 pr-6 text-xs sm:text-sm text-ink-body leading-relaxed">
                {faq.answer}
              </p>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
