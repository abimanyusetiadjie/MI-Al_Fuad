---
interface MetricItem {
  value: string;
  label: string;
}

const metrics: readonly MetricItem[] = [
  { value: 'Sejak 1990', label: '35+ Tahun Mengabdi' },
  { value: '52+ Guru', label: 'Pembina Hafidz Al-Qur’an' },
  { value: 'Juz 30 + Arti', label: 'Target Wajib Lulusan' },
  { value: '5 Jenjang', label: 'RA hingga SMK-IT & Pondok' },
] as const;
---

<section
  aria-label="Statistik Kredibilitas MI TPI & YPI Al-Fuad"
  class="bg-white border-b border-stone-200/80"
>
  <div class="container-12 py-6 md:py-8">
    <div
      class="col-span-12 grid grid-cols-2 lg:grid-cols-4 gap-y-5 gap-x-4 lg:gap-0 lg:divide-x lg:divide-stone-200/80"
    >
      {
        metrics.map((item) => (
          <div class="lg:px-6 first:lg:pl-0 last:lg:pr-0 space-y-0.5">
            <p class="font-heading text-xl sm:text-2xl font-extrabold tracking-tight text-primary-dark">
              {item.value}
            </p>
            <p class="text-xs sm:text-sm font-medium text-ink-body">
              {item.label}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
