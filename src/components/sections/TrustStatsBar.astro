---
// Overlapping 3-Column Stats Card (Adaptasi Persis Kartu 3-Statistik Mutiara Bangsa: 20 Years | 6 Campuses | 5K+ Students)
interface StatMetric {
  value: string;
  label: string;
  target?: number;
  suffix?: string;
}

const stats: readonly StatMetric[] = [
  { value: '35+', label: 'Tahun Mengabdi', target: 35, suffix: '+' },
  { value: '52+', label: 'Guru Hafidz', target: 52, suffix: '+' },
  { value: '5', label: 'Unit Terpadu', target: 5, suffix: '' },
] as const;
---

<section aria-label="Statistik Utama YPI Al-Fuad" class="relative z-20 px-4 sm:px-6 -mt-10 md:-mt-12">
  <div class="mx-auto max-w-3xl rounded-2xl bg-[#F4F7F6] border border-stone-200/90 shadow-xl grid grid-cols-3 divide-x divide-stone-200 py-5 sm:py-6 text-center">
    {
      stats.map((item) => (
        <div class="px-2 sm:px-6 space-y-0.5">
          <p
            class="font-heading text-2xl sm:text-4xl font-extrabold tracking-tight text-primary-dark tabular-nums"
            data-counter-target={item.target}
            data-counter-suffix={item.suffix}
          >
            {item.value}
          </p>
          <p class="text-[11px] sm:text-sm font-medium text-ink-body">
            {item.label}
          </p>
        </div>
      ))
    }
  </div>
</section>
