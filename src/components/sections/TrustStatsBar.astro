---
interface StatMetric {
  value: string;
  label: string;
  target?: number;
  suffix?: string;
}

const stats: readonly StatMetric[] = [
  { value: '35+', label: 'Tahun Mengabdi', target: 35, suffix: '+' },
  { value: '52+', label: 'Guru Hafidz', target: 52, suffix: '+' },
  { value: '5', label: 'Unit Terpadu', target: 5, suffix: '' },
] as const;
---

<section aria-label="Statistik Utama YPI Al-Fuad" class="relative z-20 px-4 sm:px-6 -mt-7 sm:-mt-9 md:-mt-10 pb-2 before:pointer-events-none before:absolute before:inset-x-0 before:bottom-0 before:top-7 sm:before:top-9 md:before:top-10 before:bg-white before:-z-10">
  <div class="mx-auto max-w-3xl rounded-2xl bg-surface-sage border border-line-subtle shadow-xl grid grid-cols-3 divide-x divide-line-subtle py-4 sm:py-6 text-center">
    {
      stats.map((item) => (
        <div class="px-2 sm:px-6 space-y-0.5">
          <p
            class="font-heading text-2xl sm:text-4xl font-extrabold tracking-tight text-primary-dark tabular-nums"
            data-counter-target={item.target}
            data-counter-suffix={item.suffix}
          >
            {item.value}
          </p>
          <p class="text-[11px] sm:text-sm font-medium text-ink-body">
            {item.label}
          </p>
        </div>
      ))
    }
  </div>
</section>
