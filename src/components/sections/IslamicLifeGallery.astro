---
import { Image } from 'astro:assets';
import { MapPin } from 'lucide-astro';
import { SCHOOL_FACILITIES } from '@/data/pillarsAndFacilities';
import { SITE_CONFIG } from '@/data/siteConfig';
import wisudaTahfidzImg from '@/assets/galeri/wisuda-tahfidz.webp';
import masjidAtTaqwaImg from '@/assets/galeri/masjid-at-taqwa.webp';
import ruangKelasImg from '@/assets/galeri/ruang-kelas-mi.webp';
import labKomputerImg from '@/assets/galeri/lab-komputer-smkit.webp';

interface PhotoTile {
  tag: string;
  title: string;
  image: ImageMetadata;
  alt: string;
  colSpan: string;
}

const photoTiles: readonly PhotoTile[] = [
  {
    tag: 'Wisuda & Prestasi',
    title: 'Wisuda Tahfidz Akbar Rutin',
    image: wisudaTahfidzImg,
    alt: 'Wisuda Tahfidz Al-Qur’an siswa-siswi MI TPI & YPI Al-Fuad Poris Gaga',
    colSpan: 'col-span-12 md:col-span-7',
  },
  {
    tag: 'Pusat Ibadah',
    title: "Masjid Jami' At-Taqwa",
    image: masjidAtTaqwaImg,
    alt: "Masjid Jami' At-Taqwa tempat sholat berjamaah dan halaqah tahfidz Al-Fuad",
    colSpan: 'col-span-12 md:col-span-5',
  },
  {
    tag: 'Ruang Belajar',
    title: 'Kelas Kondusif & Rapi',
    image: ruangKelasImg,
    alt: 'Ruang kelas bersih dan terang untuk pembelajaran MI TPI Al-Fuad',
    colSpan: 'col-span-12 md:col-span-5',
  },
  {
    tag: 'Praktikum Digital',
    title: 'Lab Komputer SMK-IT & SMP-IT',
    image: labKomputerImg,
    alt: 'Laboratorium komputer siswa SMK-IT dan SMP-IT Al-Fuad Poris Gaga',
    colSpan: 'col-span-12 md:col-span-7',
  },
] as const;
---

<section
  id="fasilitas"
  class="scroll-mt-24 py-14 md:py-20 bg-[#FAF8F5] border-b border-stone-200/80"
>
  <div class="container-12 gap-y-6 md:gap-y-8">
    <!-- Section Heading -->
    <div class="col-span-12 flex flex-col md:flex-row md:items-end justify-between gap-4" data-reveal>
      <div class="space-y-2 max-w-2xl">
        <p class="text-xs font-bold uppercase tracking-wider text-amber-700">
          Galeri &amp; Fasilitas Kampus
        </p>
        <h2 class="font-heading text-2xl sm:text-3xl lg:text-4xl font-bold text-ink-heading tracking-tight">
          Suasana Nyaman, Sejuk &amp; Dekat Masjid.
        </h2>
      </div>

      <a
        href={SITE_CONFIG.address.googleMapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex w-fit items-center gap-2 min-h-[44px] rounded-xl border border-stone-200 bg-[#FAF8F5] hover:bg-primary-surface px-4 py-2 text-xs sm:text-sm font-semibold text-primary-dark transition-colors"
      >
        <MapPin class="h-4 w-4 text-primary shrink-0" aria-hidden="true" />
        <span>Survei Lokasi Google Maps</span>
      </a>
    </div>

    <!-- Bento Photo Grid 12-Kolom -->
    {
      photoTiles.map((tile) => (
        <figure
          class={`${tile.colSpan} group relative overflow-hidden rounded-2xl border border-stone-200 bg-primary-dark`}
        >
          <div class="aspect-[16/10] w-full overflow-hidden">
            <Image
              src={tile.image}
              alt={tile.alt}
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption class="pointer-events-none absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent p-5 sm:p-6">
            <span class="inline-block rounded-full bg-white/15 backdrop-blur-sm px-2.5 py-0.5 text-[11px] font-semibold text-gold-light">
              {tile.tag}
            </span>
            <h3 class="mt-1.5 font-heading text-base sm:text-lg font-bold text-white">
              {tile.title}
            </h3>
          </figcaption>
        </figure>
      ))
    }

    <!-- Strip Fasilitas Ringkas -->
    <div class="col-span-12 rounded-2xl bg-[#FAF8F5] border border-stone-200/80 px-5 py-4 flex flex-wrap items-center gap-2.5">
      <span class="text-xs font-bold uppercase tracking-wider text-ink-caption mr-2">
        Fasilitas Kawasan:
      </span>
      {
        SCHOOL_FACILITIES.map((facility) => (
          <span class="rounded-lg bg-white px-3 py-1.5 text-xs font-semibold text-ink-subheading border border-stone-200/80">
            {facility.name}
          </span>
        ))
      }
    </div>
  </div>
</section>
