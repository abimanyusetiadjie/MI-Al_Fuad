---
import {
  AlertCircle,
  CheckCircle2,
  FileText,
  MessageCircle,
  Phone,
  Send,
} from 'lucide-astro';
import { PPDB_GENERAL_REQUIREMENTS, PPDB_STEPS } from '@/data/ppdbData';
import { SITE_CONFIG } from '@/data/siteConfig';
import {
  GENDER_OPTIONS,
  QURAN_READING_LEVEL_OPTIONS,
  TARGET_UNIT_OPTIONS,
  buildQuickWhatsAppUrl,
} from '@/utils/whatsapp';

const fallbackQuickWaUrl = buildQuickWhatsAppUrl();
---

<section
  id="daftar-ppdb"
  class="scroll-mt-24 py-14 md:py-20 bg-white border-b border-stone-200/80"
>
  <div class="container-12 items-start gap-y-8 md:gap-y-10">
    <!-- Kolom Kiri (5 Kolom Desktop): Alur Ringkas & Syarat Expandable -->
    <div class="col-span-12 lg:col-span-5 space-y-6">
      <div class="space-y-2.5">
        <p class="text-xs font-bold uppercase tracking-wider text-amber-700">
          Alur Pendaftaran PPDB
        </p>
        <h2 class="font-heading text-2xl sm:text-3xl font-bold text-ink-heading tracking-tight">
          4 Langkah Mudah Daftar ke Al-Fuad.
        </h2>
        <p class="text-sm text-ink-body">
          Isi data singkat di samping untuk langsung terhubung ke WhatsApp Panitia PPDB.
        </p>
      </div>

      <!-- Stepper Bersih Berbasis Garis Tipis -->
      <ol class="divide-y divide-stone-200 border-y border-stone-200">
        {
          PPDB_STEPS.map((step) => (
            <li class="py-3.5 flex items-start gap-3.5">
              <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-primary-dark font-heading text-xs font-bold text-gold-light mt-0.5">
                {step.stepNumber}
              </span>
              <div>
                <h3 class="font-heading text-sm font-bold text-ink-heading">
                  {step.title}
                </h3>
                <p class="mt-0.5 text-xs text-ink-body leading-relaxed">
                  {step.description}
                </p>
              </div>
            </li>
          ))
        }
      </ol>

      <!-- Syarat Berkas (Collapsible agar Tidak Memenuhi Layar HP) -->
      <details class="group rounded-xl border border-stone-200 bg-[#FAF8F5] px-4 py-3">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-2 text-xs sm:text-sm font-bold text-ink-heading [&::-webkit-details-marker]:hidden">
          <span class="inline-flex items-center gap-2">
            <FileText class="h-4 w-4 text-amber-700 shrink-0" aria-hidden="true" />
            <span>Lihat Syarat Berkas Daftar Ulang (6 Poin)</span>
          </span>
          <span class="text-xs font-semibold text-primary transition-transform group-open:rotate-90" aria-hidden="true">
            &rsaquo;
          </span>
        </summary>
        <ul class="mt-3 pt-3 border-t border-stone-200 space-y-1.5 text-xs text-ink-body">
          {
            PPDB_GENERAL_REQUIREMENTS.map((req) => (
              <li class="flex items-start gap-2">
                <CheckCircle2 class="h-3.5 w-3.5 text-primary shrink-0 mt-0.5" aria-hidden="true" />
                <span>{req}</span>
              </li>
            ))
          }
        </ul>
      </details>

      <!-- Info Bantuan Langsung Sekretariat -->
      <div class="rounded-xl bg-primary-surface/65 p-4 border border-primary/15 flex flex-wrap items-center justify-between gap-3">
        <div>
          <p class="text-[11px] font-bold uppercase tracking-wider text-primary-dark">
            Sekretariat PPDB Poris Gaga
          </p>
          <p class="text-xs text-ink-subheading">
            {SITE_CONFIG.contact.operatingHours}
          </p>
        </div>

        <a
          href={fallbackQuickWaUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 min-h-[44px] rounded-xl bg-white px-3.5 py-2 text-xs font-bold text-primary-dark border border-primary/20 hover:bg-emerald-50 transition-colors"
        >
          <Phone class="h-3.5 w-3.5 text-primary shrink-0" aria-hidden="true" />
          <span>{SITE_CONFIG.contact.whatsappDisplay}</span>
        </a>
      </div>
    </div>

    <!-- Kolom Kanan (7 Kolom Desktop): Smart Formulir Pendaftaran PPDB Instan -->
    <div
      id="ppdb-form"
      class="col-span-12 lg:col-span-7 scroll-mt-24 rounded-2xl bg-white p-5 sm:p-8 border border-stone-200/90 shadow-sm space-y-5"
    >
      <div class="space-y-1.5 border-b border-stone-200 pb-4">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <span class="inline-flex items-center gap-1.5 rounded-full bg-gold-light px-2.5 py-0.5 text-[11px] font-bold text-amber-800">
            <MessageCircle class="h-3 w-3 shrink-0" aria-hidden="true" />
            <span>Terhubung Otomatis ke WhatsApp Panitia</span>
          </span>
          <span class="text-xs font-semibold text-primary">
            Gratis &amp; Tanpa Login
          </span>
        </div>

        <h3 class="font-heading text-xl sm:text-2xl font-bold text-ink-heading">
          Formulir Pendaftaran PPDB Instan
        </h3>
        <p class="text-xs sm:text-sm text-ink-body">
          Pesan resmi pendaftaran otomatis tersusun menuju WhatsApp Panitia ({SITE_CONFIG.contact.whatsappDisplay}).
        </p>
      </div>

      <!-- Alert Error Summary -->
      <div
        id="ppdb-form-error-summary"
        role="alert"
        class="hidden rounded-2xl border border-red-200 bg-red-50 p-4 text-xs sm:text-sm text-red-800"
      >
        <div class="flex items-start gap-2.5">
          <AlertCircle class="h-5 w-5 text-red-600 shrink-0 mt-0.5" aria-hidden="true" />
          <div>
            <p class="font-bold">Mohon periksa kembali isian formulir:</p>
            <p id="ppdb-form-error-text" class="mt-0.5"></p>
          </div>
        </div>
      </div>

      <!-- Success Preview Banner -->
      <div
        id="ppdb-form-success-banner"
        role="status"
        class="hidden rounded-2xl border border-primary/30 bg-primary-surface p-4 sm:p-5 space-y-3"
      >
        <div class="flex items-start gap-2.5">
          <CheckCircle2 class="h-5 w-5 text-primary shrink-0 mt-0.5" aria-hidden="true" />
          <div class="space-y-1">
            <p class="font-heading text-sm sm:text-base font-bold text-primary-dark">
              Data Siap Dikirim ke Panitia PPDB YPI Al-Fuad!
            </p>
            <p class="text-xs sm:text-sm text-ink-subheading">
              Jendela WhatsApp sedang dibuka. Jika belum terbuka otomatis pada
              perangkat Anda, silakan tekan tombol di bawah ini:
            </p>
          </div>
        </div>
        <a
          id="ppdb-wa-direct-link"
          href={fallbackQuickWaUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex w-full sm:w-auto items-center justify-center gap-2 min-h-[48px] rounded-xl bg-primary hover:bg-primary-dark px-5 py-2.5 text-sm font-bold text-white shadow-sm transition-colors"
        >
          <MessageCircle class="h-4 w-4 shrink-0" aria-hidden="true" />
          <span>Buka WhatsApp Panitia Sekarang</span>
        </a>
      </div>

      <form id="ppdb-wa-form" novalidate class="grid grid-cols-12 gap-4">
        <!-- Nama Lengkap Calon Siswa -->
        <div class="col-span-12 sm:col-span-6 space-y-1.5">
          <label
            for="ppdb-studentName"
            class="block text-xs sm:text-sm font-semibold text-ink-heading"
          >
            Nama Lengkap Calon Siswa <span class="text-red-600">*</span>
          </label>
          <input
            id="ppdb-studentName"
            name="studentName"
            type="text"
            required
            autocomplete="name"
            placeholder="Contoh: Muhammad Fatih Al-Faruq"
            class="w-full min-h-[48px] rounded-xl border border-primary-dark/20 bg-surface-alabaster px-3.5 py-2.5 text-sm text-ink-heading placeholder:text-ink-caption/70 focus:border-primary focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary/20"
          />
          <p data-error-for="studentName" class="hidden text-xs font-medium text-red-600"></p>
        </div>

        <!-- Pilihan Jenjang -->
        <div class="col-span-12 sm:col-span-6 space-y-1.5">
          <label
            for="ppdb-targetUnit"
            class="block text-xs sm:text-sm font-semibold text-ink-heading"
          >
            Pilihan Jenjang Pendidikan <span class="text-red-600">*</span>
          </label>
          <select
            id="ppdb-targetUnit"
            name="targetUnit"
            data-ppdb-unit-select
            required
            class="w-full min-h-[48px] rounded-xl border border-primary-dark/20 bg-surface-alabaster px-3.5 py-2.5 text-sm font-medium text-ink-heading focus:border-primary focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary/20"
          >
            {
              TARGET_UNIT_OPTIONS.map((unitOption) => (
                <option value={unitOption} selected={unitOption === 'MI TPI Al-Fuad (Setara SD Islam)'}>
                  {unitOption}
                </option>
              ))
            }
          </select>
          <p data-error-for="targetUnit" class="hidden text-xs font-medium text-red-600"></p>
        </div>

        <!-- Jenis Kelamin -->
        <div class="col-span-12 sm:col-span-6 space-y-1.5">
          <label
            for="ppdb-gender"
            class="block text-xs sm:text-sm font-semibold text-ink-heading"
          >
            Jenis Kelamin <span class="text-red-600">*</span>
          </label>
          <select
            id="ppdb-gender"
            name="gender"
            class="w-full min-h-[48px] rounded-xl border border-primary-dark/20 bg-surface-alabaster px-3.5 py-2.5 text-sm text-ink-heading focus:border-primary focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary/20"
          >
            {
              GENDER_OPTIONS.map((genderOption) => (
                <option value={genderOption}>{genderOption}</option>
              ))
            }
          </select>
          <p data-error-for="gender" class="hidden text-xs font-medium text-red-600"></p>
        </div>

        <!-- Asal Sekolah / Usia -->
        <div class="col-span-12 sm:col-span-6 space-y-1.5">
          <label
            for="ppdb-previousSchoolOrAge"
            class="block text-xs sm:text-sm font-semibold text-ink-heading"
          >
            Asal Sekolah / Usia Anak
            <span id="ppdb-school-required-mark" class="text-red-600">*</span>
            <span id="ppdb-school-optional-badge" class="hidden text-xs font-normal text-ink-caption">
              (Opsional untuk RA)
            </span>
          </label>
          <input
            id="ppdb-previousSchoolOrAge"
            name="previousSchoolOrAge"
            type="text"
            placeholder="Contoh: TK Islam Poris / 6,5 Thn"
            class="w-full min-h-[48px] rounded-xl border border-primary-dark/20 bg-surface-alabaster px-3.5 py-2.5 text-sm text-ink-heading placeholder:text-ink-caption/70 focus:border-primary focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary/20"
          />
          <p
            data-error-for="previousSchoolOrAge"
            class="hidden text-xs font-medium text-red-600"
          >
          </p>
        </div>

        <!-- Kemampuan Mengaji -->
        <div class="col-span-12 sm:col-span-6 space-y-1.5">
          <label
            for="ppdb-quranReadingLevel"
            class="block text-xs sm:text-sm font-semibold text-ink-heading"
          >
            Kemampuan Mengaji Saat Ini
          </label>
          <select
            id="ppdb-quranReadingLevel"
            name="quranReadingLevel"
            class="w-full min-h-[48px] rounded-xl border border-primary-dark/20 bg-surface-alabaster px-3.5 py-2.5 text-sm text-ink-heading focus:border-primary focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary/20"
          >
            {
              QURAN_READING_LEVEL_OPTIONS.map((level) => (
                <option value={level}>{level}</option>
              ))
            }
          </select>
          <p
            data-error-for="quranReadingLevel"
            class="hidden text-xs font-medium text-red-600"
          >
          </p>
        </div>

        <!-- Nama Orang Tua / Wali -->
        <div class="col-span-12 sm:col-span-6 space-y-1.5">
          <label
            for="ppdb-parentName"
            class="block text-xs sm:text-sm font-semibold text-ink-heading"
          >
            Nama Orang Tua / Wali <span class="text-red-600">*</span>
          </label>
          <input
            id="ppdb-parentName"
            name="parentName"
            type="text"
            required
            placeholder="Contoh: Ibu Siti Rahmawati"
            class="w-full min-h-[48px] rounded-xl border border-primary-dark/20 bg-surface-alabaster px-3.5 py-2.5 text-sm text-ink-heading placeholder:text-ink-caption/70 focus:border-primary focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary/20"
          />
          <p data-error-for="parentName" class="hidden text-xs font-medium text-red-600"></p>
        </div>

        <!-- Domisili / Kelurahan -->
        <div class="col-span-12 sm:col-span-6 space-y-1.5">
          <label
            for="ppdb-domicileArea"
            class="block text-xs sm:text-sm font-semibold text-ink-heading"
          >
            Domisili / Kelurahan <span class="text-red-600">*</span>
          </label>
          <input
            id="ppdb-domicileArea"
            name="domicileArea"
            type="text"
            required
            placeholder="Contoh: Poris Gaga / Cipondoh"
            class="w-full min-h-[48px] rounded-xl border border-primary-dark/20 bg-surface-alabaster px-3.5 py-2.5 text-sm text-ink-heading placeholder:text-ink-caption/70 focus:border-primary focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary/20"
          />
          <p data-error-for="domicileArea" class="hidden text-xs font-medium text-red-600"></p>
        </div>

        <!-- Nomor WhatsApp Aktif -->
        <div class="col-span-12 sm:col-span-6 space-y-1.5">
          <label
            for="ppdb-whatsappNumber"
            class="block text-xs sm:text-sm font-semibold text-ink-heading"
          >
            Nomor WhatsApp Aktif <span class="text-red-600">*</span>
          </label>
          <input
            id="ppdb-whatsappNumber"
            name="whatsappNumber"
            type="tel"
            inputmode="tel"
            required
            autocomplete="tel"
            placeholder="Contoh: 081234567890"
            class="w-full min-h-[48px] rounded-xl border border-primary-dark/20 bg-surface-alabaster px-3.5 py-2.5 text-sm text-ink-heading placeholder:text-ink-caption/70 focus:border-primary focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary/20"
          />
          <p data-error-for="whatsappNumber" class="hidden text-xs font-medium text-red-600"></p>
        </div>

        <!-- Pertanyaan Tambahan -->
        <div class="col-span-12 space-y-1.5">
          <label
            for="ppdb-additionalNotes"
            class="block text-xs sm:text-sm font-semibold text-ink-heading"
          >
            Pertanyaan Tambahan <span class="text-xs font-normal text-ink-caption">(Opsional)</span>
          </label>
          <textarea
            id="ppdb-additionalNotes"
            name="additionalNotes"
            rows="3"
            placeholder="Contoh: Ingin menjadwalkan survei sekolah hari Sabtu pagi dan menanyakan skema cicilan DSP."
            class="w-full rounded-xl border border-primary-dark/20 bg-surface-alabaster px-3.5 py-2.5 text-sm text-ink-heading placeholder:text-ink-caption/70 focus:border-primary focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary/20"
          ></textarea>
          <p data-error-for="additionalNotes" class="hidden text-xs font-medium text-red-600"></p>
        </div>

        <!-- Submit Button -->
        <div class="col-span-12 pt-2 space-y-2.5">
          <button
            type="submit"
            class="inline-flex w-full items-center justify-center gap-2.5 min-h-[52px] rounded-xl bg-amber-700 hover:bg-amber-800 px-6 py-3.5 text-sm sm:text-base font-bold text-white shadow-md transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700"
          >
            <Send class="h-5 w-5 shrink-0" aria-hidden="true" />
            <span>Kirim Pendaftaran ke Panitia PPDB</span>
          </button>

          <p class="text-center text-xs text-ink-caption">
            Dengan menekan tombol di atas, pesan pendaftaran resmi akan terbuka
            otomatis di aplikasi WhatsApp Anda tanpa biaya tambahan.
          </p>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  import {
    buildWhatsAppPpdbUrl,
    ppdbInquirySchema,
  } from '@/utils/whatsapp';

  const form = document.getElementById('ppdb-wa-form') as HTMLFormElement | null;
  const unitSelect = document.getElementById('ppdb-targetUnit') as HTMLSelectElement | null;
  const schoolRequiredMark = document.getElementById('ppdb-school-required-mark');
  const schoolOptionalBadge = document.getElementById('ppdb-school-optional-badge');
  const errorSummary = document.getElementById('ppdb-form-error-summary');
  const errorSummaryText = document.getElementById('ppdb-form-error-text');
  const successBanner = document.getElementById('ppdb-form-success-banner');
  const directWaLink = document.getElementById('ppdb-wa-direct-link') as HTMLAnchorElement | null;

  const updateSchoolRequirementLabel = () => {
    if (!unitSelect) return;
    const isRa = unitSelect.value === 'RA Al-Fuad';
    if (schoolRequiredMark) schoolRequiredMark.classList.toggle('hidden', isRa);
    if (schoolOptionalBadge) schoolOptionalBadge.classList.toggle('hidden', !isRa);
  };

  const applySelectedUnit = (unitValue: string | null | undefined) => {
    if (!unitSelect || !unitValue) return;
    const matchingOption = Array.from(unitSelect.options).find(
      (opt) => opt.value === unitValue,
    );
    if (matchingOption) {
      unitSelect.value = unitValue;
      updateSchoolRequirementLabel();
      unitSelect.classList.add('ring-2', 'ring-amber-500');
      setTimeout(() => {
        unitSelect.classList.remove('ring-2', 'ring-amber-500');
      }, 1600);
    }
  };

  const clearAllFieldErrors = () => {
    if (!form) return;
    const errorNodes = form.querySelectorAll('[data-error-for]');
    errorNodes.forEach((node) => {
      node.textContent = '';
      node.classList.add('hidden');
    });
    const inputs = form.querySelectorAll('input, select, textarea');
    inputs.forEach((el) => {
      el.classList.remove('border-red-500', 'ring-2', 'ring-red-200');
      el.removeAttribute('aria-invalid');
    });
    if (errorSummary) errorSummary.classList.add('hidden');
  };

  const showFieldError = (fieldName: string, message: string) => {
    if (!form) return;
    const errorNode = form.querySelector(`[data-error-for="${fieldName}"]`);
    if (errorNode) {
      errorNode.textContent = message;
      errorNode.classList.remove('hidden');
    }
    const fieldEl = form.querySelector(`[name="${fieldName}"]`);
    if (fieldEl) {
      fieldEl.classList.add('border-red-500', 'ring-2', 'ring-red-200');
      fieldEl.setAttribute('aria-invalid', 'true');
    }
  };

  if (unitSelect) {
    // Sinkronkan apabila tombol "Pilih Jenjang Ini" sudah diklik sebelum script termuat
    const preselected = (window as Window & { __selectedPpdbUnit?: string }).__selectedPpdbUnit;
    if (preselected) {
      applySelectedUnit(preselected);
    } else {
      try {
        const stored = sessionStorage.getItem('ypi_selected_ppdb_unit');
        if (stored) applySelectedUnit(stored);
      } catch (_err) {
        // Abaikan jika sessionStorage tidak tersedia
      }
    }

    updateSchoolRequirementLabel();
    unitSelect.addEventListener('change', updateSchoolRequirementLabel);
  }

  window.addEventListener('ppdb:select-unit', (event: Event) => {
    const customEvent = event as CustomEvent<{ unit?: string }>;
    if (customEvent.detail?.unit) {
      applySelectedUnit(customEvent.detail.unit);
    }
  });

  if (form) {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      clearAllFieldErrors();
      if (successBanner) successBanner.classList.add('hidden');

      const formData = new FormData(form);
      const rawPayload = {
        studentName: String(formData.get('studentName') ?? ''),
        targetUnit: String(formData.get('targetUnit') ?? ''),
        gender: String(formData.get('gender') ?? ''),
        previousSchoolOrAge: String(formData.get('previousSchoolOrAge') ?? ''),
        quranReadingLevel: String(formData.get('quranReadingLevel') ?? ''),
        parentName: String(formData.get('parentName') ?? ''),
        domicileArea: String(formData.get('domicileArea') ?? ''),
        whatsappNumber: String(formData.get('whatsappNumber') ?? ''),
        additionalNotes: String(formData.get('additionalNotes') ?? ''),
      };

      const parsed = ppdbInquirySchema.safeParse(rawPayload);

      if (!parsed.success) {
        let firstErrorField: string | null = null;
        for (const issue of parsed.error.issues) {
          const fieldKey = String(issue.path[0] ?? '');
          if (fieldKey) {
            showFieldError(fieldKey, issue.message);
            if (!firstErrorField) firstErrorField = fieldKey;
          }
        }

        if (errorSummary && errorSummaryText) {
          errorSummaryText.textContent =
            parsed.error.issues[0]?.message ??
            'Beberapa kolom wajib masih perlu dilengkapi dengan benar.';
          errorSummary.classList.remove('hidden');
        }

        if (firstErrorField) {
          const firstEl = form.querySelector(`[name="${firstErrorField}"]`);
          if (firstEl instanceof HTMLElement) {
            firstEl.focus();
          }
        }
        return;
      }

      const whatsappUrl = buildWhatsAppPpdbUrl(parsed.data);

      if (directWaLink) {
        directWaLink.href = whatsappUrl;
      }
      if (successBanner) {
        successBanner.classList.remove('hidden');
      }

      const openedWindow = window.open(whatsappUrl, '_blank', 'noopener,noreferrer');
      if (!openedWindow) {
        window.location.href = whatsappUrl;
      }
    });
  }
</script>
