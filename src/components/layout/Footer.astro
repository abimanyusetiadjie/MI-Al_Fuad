---
import { ArrowUp, Mail, MapPin, MessageCircle, Phone } from 'lucide-astro';
import { SITE_CONFIG } from '@/data/siteConfig';
import { buildQuickWhatsAppUrl } from '@/utils/whatsapp';

const isHomePage = Astro.url.pathname === '/';
const prefix = isHomePage ? '' : '/';
const currentYear = new Date().getFullYear();
const quickWaUrl = buildQuickWhatsAppUrl();

const navLinks = [
  { label: 'Beranda', href: `${prefix}#top` },
  { label: 'Visi & Misi', href: `${prefix}#visi-misi` },
  { label: '5 Unit Sekolah', href: `${prefix}#jenjang` },
  { label: 'Kabar & Agenda', href: `${prefix}#kabar` },
  { label: 'Biaya PPDB', href: `${prefix}#biaya-ppdb` },
  { label: 'FAQ', href: `${prefix}#faq` },
] as const;
---

<!-- Clean White 4-Column Footer (Adaptasi Footer Mutiara Bangsa + Kelengkapan NPSN Resmi Al-Fuad) -->
<footer id="kontak" class="bg-white border-t border-stone-200 mt-auto text-ink-body">
  <div class="mx-auto max-w-[1280px] px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <div class="grid grid-cols-12 gap-y-8 gap-x-6 items-start">
      <!-- Kolom 1 (3 Col): Logo + Editorial Summary + Back to Top Pill -->
      <div class="col-span-12 md:col-span-6 lg:col-span-3 space-y-4">
        <a href="#top" class="inline-flex items-center gap-2.5">
          <span
            class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-primary-dark text-gold-medium"
            aria-hidden="true"
          >
            <svg viewBox="0 0 36 36" class="h-5 w-5" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M18 5L29 12.5V28H7V12.5L18 5Z" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" />
              <path d="M18 13V28M12 18.5C14.2 17.3 16.3 17.5 18 19C19.7 17.5 21.8 17.3 24 18.5" stroke="#ECFDF5" stroke-width="2" stroke-linecap="round" />
            </svg>
          </span>
          <span class="font-heading text-base font-extrabold text-primary-dark">
            MI TPI &amp; YPI Al-Fuad
          </span>
        </a>

        <p class="text-xs sm:text-sm text-ink-body leading-relaxed">
          Membina generasi Qur'ani sejak {SITE_CONFIG.foundedYear} di Poris Gaga, Kota Tangerang di bawah asuhan{' '}
          <strong class="font-semibold text-ink-heading">{SITE_CONFIG.chairman}</strong>.
        </p>

        <a
          href="#top"
          class="inline-flex items-center gap-1.5 min-h-[44px] rounded-xl bg-primary-surface hover:bg-emerald-100 px-4 py-2 text-xs font-bold text-primary-dark transition-colors"
        >
          <span>Kembali ke Atas</span>
          <ArrowUp class="h-3.5 w-3.5 shrink-0" aria-hidden="true" />
        </a>
      </div>

      <!-- Kolom 2 (2 Col): Navigasi Cepat -->
      <div class="col-span-6 md:col-span-3 lg:col-span-2 space-y-3">
        <h3 class="font-heading text-sm font-bold text-primary-dark">
          Navigasi
        </h3>
        <ul class="space-y-1 text-xs sm:text-sm">
          {
            navLinks.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="inline-flex items-center min-h-[36px] text-ink-body hover:text-primary-dark font-medium transition-colors"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Kolom 3 (4 Col): Daftar 5 Unit & NPSN Resmi -->
      <div class="col-span-12 sm:col-span-6 md:col-span-3 lg:col-span-4 space-y-3">
        <h3 class="font-heading text-sm font-bold text-primary-dark">
          5 Unit Pendidikan &amp; NPSN
        </h3>
        <ul class="space-y-2 text-xs">
          {
            SITE_CONFIG.units.map((unit) => (
              <li class="flex items-center justify-between gap-2 pb-1.5 border-b border-stone-100 last:border-b-0 last:pb-0">
                <span class="font-medium text-ink-heading">{unit.name}</span>
                <span class="shrink-0 font-mono text-[11px] font-bold text-amber-700 bg-gold-light/60 px-2 py-0.5 rounded">
                  {unit.npsn === 'Terdaftar Kemenag' ? 'Kemenag RI' : `NPSN ${unit.npsn}`}
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Kolom 4 (3 Col): Alamat & Kontak Sekretariat -->
      <div class="col-span-12 md:col-span-6 lg:col-span-3 space-y-3">
        <h3 class="font-heading text-sm font-bold text-primary-dark">
          Sekretariat PPDB
        </h3>
        <address class="not-italic space-y-2 text-xs text-ink-body">
          <p class="flex items-start gap-2">
            <MapPin class="h-4 w-4 text-primary shrink-0 mt-0.5" aria-hidden="true" />
            <span>{SITE_CONFIG.address.fullAddress}</span>
          </p>
          <p class="flex items-center gap-2">
            <MessageCircle class="h-4 w-4 text-primary shrink-0" aria-hidden="true" />
            <a
              href={quickWaUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="font-bold text-primary-dark hover:underline min-h-[36px] inline-flex items-center"
            >
              WA {SITE_CONFIG.contact.whatsappDisplay}
            </a>
          </p>
          <p class="flex items-center gap-2">
            <Phone class="h-4 w-4 text-primary shrink-0" aria-hidden="true" />
            <a href="tel:+622155740372" class="hover:text-primary-dark min-h-[36px] inline-flex items-center">
              {SITE_CONFIG.contact.phoneOffice1}
            </a>
          </p>
          <p class="flex items-center gap-2">
            <Mail class="h-4 w-4 text-primary shrink-0" aria-hidden="true" />
            <a href={`mailto:${SITE_CONFIG.contact.email}`} class="hover:text-primary-dark break-all">
              {SITE_CONFIG.contact.email}
            </a>
          </p>
        </address>

        <a
          href={SITE_CONFIG.address.googleMapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex w-full items-center justify-center gap-2 min-h-[44px] rounded-xl bg-primary-dark hover:bg-primary px-4 py-2 text-xs font-semibold text-white transition-colors"
        >
          <MapPin class="h-3.5 w-3.5 shrink-0" aria-hidden="true" />
          <span>Buka Lokasi di Google Maps</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Copyright Centered Bar Persis Mutiara Bangsa -->
  <div class="border-t border-stone-200 py-5 px-4 text-center text-xs text-ink-caption">
    &copy; {currentYear} MI TPI &amp; {SITE_CONFIG.foundationName} &mdash; All Rights Reserved.
  </div>
</footer>
