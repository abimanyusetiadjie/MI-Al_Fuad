---
import { ArrowUp, Clock, Mail, MapPin, MessageCircle, Navigation, Phone, ShieldCheck } from 'lucide-astro';
import { SITE_CONFIG } from '@/data/siteConfig';
import { buildQuickWhatsAppUrl } from '@/utils/whatsapp';

const isHomePage = Astro.url.pathname === '/';
const prefix = isHomePage ? '' : '/';
const currentYear = new Date().getFullYear();
const quickWaUrl = buildQuickWhatsAppUrl();

const navLinks = [
  { label: 'Beranda', href: `${prefix}#top` },
  { label: 'Visi & Misi', href: `${prefix}#visi-misi` },
  { label: '5 Unit Sekolah', href: `${prefix}#jenjang` },
  { label: 'Kabar & Agenda', href: `${prefix}#kabar` },
  { label: 'Biaya PPDB', href: `${prefix}#biaya-ppdb` },
  { label: 'FAQ PPDB', href: `${prefix}#faq` },
] as const;
---

<!-- Editorial Deep Emerald Footer (Grid 12-Kolom Presisi di Mobile & Desktop) -->
<footer id="kontak" class="bg-primary-dark text-emerald-50 border-t-4 border-gold mt-auto">
  <div class="mx-auto max-w-[1280px] px-4 sm:px-6 lg:px-8 py-10 md:py-14">
    <div class="grid grid-cols-12 gap-y-8 gap-x-4 sm:gap-x-6 lg:gap-x-8 items-start">
      <!-- Kolom 1 (Desktop 3 Col, Mobile Full): Brand Identity + Quick Action -->
      <div class="col-span-12 lg:col-span-3 space-y-4">
        <div class="flex items-start justify-between gap-3">
          <a href="#top" class="inline-flex items-center gap-2.5 min-h-[44px]">
            <span
              class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-white/10 text-gold ring-1 ring-white/15"
              aria-hidden="true"
            >
              <svg viewBox="0 0 36 36" class="h-5 w-5" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M18 5L29 12.5V28H7V12.5L18 5Z" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" />
                <path d="M18 13V28M12 18.5C14.2 17.3 16.3 17.5 18 19C19.7 17.5 21.8 17.3 24 18.5" stroke="#ECFDF5" stroke-width="2" stroke-linecap="round" />
              </svg>
            </span>
            <span class="flex flex-col leading-tight">
              <span class="font-heading text-base font-extrabold text-white">
                MI TPI &amp; YPI Al-Fuad
              </span>
              <span class="text-[11px] font-semibold text-gold-light">
                Poris Gaga &bull; Sejak {SITE_CONFIG.foundedYear}
              </span>
            </span>
          </a>

          <!-- Tombol Back to Top Ringkas di Kanan Atas Mobile -->
          <a
            href="#top"
            aria-label="Kembali ke atas halaman"
            class="lg:hidden inline-flex items-center gap-1 min-h-[40px] rounded-xl bg-white/10 hover:bg-white/20 px-3 py-1.5 text-xs font-semibold text-white border border-white/15 transition-colors shrink-0"
          >
            <span>Atas</span>
            <ArrowUp class="h-3.5 w-3.5" aria-hidden="true" />
          </a>
        </div>

        <p class="text-xs sm:text-sm text-emerald-100/80 leading-relaxed">
          {SITE_CONFIG.foundationName} di bawah asuhan{' '}
          <strong class="font-semibold text-white">{SITE_CONFIG.chairman}</strong>. Membimbing generasi Qur'ani dari nol hingga hafal &amp; paham Juz 30.
        </p>

        <div class="flex flex-wrap items-center gap-2.5 pt-0.5">
          <a
            href={quickWaUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 min-h-[44px] rounded-xl bg-gold hover:bg-gold-hover px-4 py-2 text-xs sm:text-sm font-bold text-ink-heading shadow-sm transition-colors"
          >
            <MessageCircle class="h-4 w-4 shrink-0" aria-hidden="true" />
            <span>Konsultasi PPDB</span>
          </a>

          <a
            href="#top"
            class="hidden lg:inline-flex items-center gap-1.5 min-h-[44px] rounded-xl bg-white/10 hover:bg-white/20 px-3.5 py-2 text-xs font-semibold text-white border border-white/15 transition-colors"
          >
            <ArrowUp class="h-3.5 w-3.5 shrink-0" aria-hidden="true" />
            <span>Ke Atas</span>
          </a>
        </div>
      </div>

      <!-- Kolom 2 (Mobile Full 2-Kolom Kompak, Desktop 2 Col): Navigasi Ringkas -->
      <div class="col-span-12 sm:col-span-4 lg:col-span-2 space-y-2.5 sm:space-y-3">
        <h3 class="font-heading text-xs font-bold uppercase tracking-wider text-gold-light">
          Navigasi
        </h3>
        <ul class="grid grid-cols-2 sm:grid-cols-1 gap-x-4 gap-y-0.5 text-xs sm:text-sm">
          {
            navLinks.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="inline-flex items-center min-h-[38px] text-emerald-100/85 hover:text-gold-light font-medium transition-colors"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Kolom 3 (Mobile Full Width agar Nama Unit Tidak Terpotong, Desktop 4 Col): Daftar Resmi 5 Unit & NPSN -->
      <div class="col-span-12 sm:col-span-8 lg:col-span-4 space-y-3">
        <h3 class="font-heading text-xs font-bold uppercase tracking-wider text-gold-light flex items-center gap-1.5">
          <ShieldCheck class="h-3.5 w-3.5 text-gold shrink-0" aria-hidden="true" />
          <span>Unit Resmi &amp; NPSN</span>
        </h3>
        <div class="rounded-2xl bg-white/5 border border-white/10 p-3.5 sm:p-4">
          <ul class="divide-y divide-white/10 text-xs">
            {
              SITE_CONFIG.units.map((unit) => (
                <li class="py-2 first:pt-0 last:pb-0 flex items-center justify-between gap-2.5">
                  <span class="font-medium text-white leading-snug">{unit.name}</span>
                  <span class="shrink-0 font-mono text-[11px] font-bold text-gold-light bg-white/10 px-2 py-0.5 rounded border border-white/10">
                    {unit.npsn === 'Terdaftar Kemenag' ? 'Kemenag' : unit.npsn}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <!-- Kolom 4 (Desktop 3 Col, Mobile Full): Kartu Sekretariat & Peta Lokasi -->
      <div class="col-span-12 lg:col-span-3 space-y-3">
        <h3 class="font-heading text-xs font-bold uppercase tracking-wider text-gold-light">
          Sekretariat &amp; Lokasi
        </h3>
        <div class="rounded-2xl bg-white/5 border border-white/10 p-4 space-y-3 text-xs text-emerald-100/85">
          <p class="flex items-start gap-2 leading-relaxed">
            <MapPin class="h-4 w-4 text-gold shrink-0 mt-0.5" aria-hidden="true" />
            <span>{SITE_CONFIG.address.fullAddress}</span>
          </p>

          <p class="flex items-center gap-2">
            <Clock class="h-4 w-4 text-gold shrink-0" aria-hidden="true" />
            <span>{SITE_CONFIG.contact.operatingHours}</span>
          </p>

          <div class="pt-2 border-t border-white/10 flex flex-wrap items-center gap-x-4 gap-y-1.5">
            <a
              href="tel:+622155740372"
              class="inline-flex items-center gap-1.5 min-h-[36px] text-white hover:text-gold-light font-medium transition-colors"
            >
              <Phone class="h-3.5 w-3.5 text-gold shrink-0" aria-hidden="true" />
              <span>{SITE_CONFIG.contact.phoneOffice1}</span>
            </a>
            <a
              href={`mailto:${SITE_CONFIG.contact.email}`}
              class="inline-flex items-center gap-1.5 min-h-[36px] text-emerald-100/85 hover:text-gold-light transition-colors break-all"
            >
              <Mail class="h-3.5 w-3.5 text-gold shrink-0" aria-hidden="true" />
              <span>{SITE_CONFIG.contact.email}</span>
            </a>
          </div>

          <a
            href={SITE_CONFIG.address.googleMapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex w-full items-center justify-center gap-2 min-h-[44px] rounded-xl bg-white/10 hover:bg-white/20 border border-white/20 px-3.5 py-2 text-xs font-semibold text-white transition-colors"
          >
            <Navigation class="h-3.5 w-3.5 text-gold shrink-0" aria-hidden="true" />
            <span>Buka Rute Google Maps</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Legal Bar (Extra bottom padding di Mobile agar tidak tertutup FAB WhatsApp) -->
  <div class="border-t border-white/10 bg-black/15">
    <div class="mx-auto max-w-[1280px] px-4 sm:px-6 lg:px-8 pt-4 pb-20 sm:pb-5 flex flex-col sm:flex-row items-center justify-between gap-2 text-[11px] sm:text-xs text-emerald-100/75 text-center sm:text-left">
      <p>
        &copy; {currentYear} MI TPI &amp; {SITE_CONFIG.foundationName}. All rights reserved.
      </p>
      <p>
        Poris Gaga, Batuceper, Kota Tangerang &bull; Banten {SITE_CONFIG.address.postalCode}
      </p>
    </div>
  </div>
</footer>
