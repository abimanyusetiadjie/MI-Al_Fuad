---
import { ChevronDown, Menu, MessageCircle, X } from 'lucide-astro';
import { SITE_CONFIG } from '@/data/siteConfig';
import { buildQuickWhatsAppUrl } from '@/utils/whatsapp';

const isHomePage = Astro.url.pathname === '/';
const prefix = isHomePage ? '' : '/';

const aboutLinks = [
  { label: 'Visi & Misi', href: `${prefix}#visi-misi` },
  { label: 'Sambutan Pengasuh', href: `${prefix}#sambutan` },
  { label: 'Keunggulan & Prestasi', href: `${prefix}#program-tahfidz` },
  { label: 'Tanya Jawab (FAQ)', href: `${prefix}#faq` },
] as const;

const schoolLinks = [
  { label: 'RA / TK Islam Al-Fuad', href: `${prefix}#jenjang`, unitId: 'ra' },
  { label: 'MI TPI Al-Fuad (Setara SD)', href: `${prefix}#jenjang`, unitId: 'mit' },
  { label: 'SMP-IT Al-Fuad', href: `${prefix}#jenjang`, unitId: 'smpit' },
  { label: 'SMK-IT Al-Fuad', href: `${prefix}#jenjang`, unitId: 'smkit' },
  { label: 'Pondok Pesantren', href: `${prefix}#jenjang`, unitId: 'pesantren' },
] as const;

const quickWaUrl = buildQuickWhatsAppUrl();
---

<!-- Sticky Clean White Header -->
<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-line-subtle shadow-[0_1px_10px_rgba(15,23,42,0.04)]">
  <div class="mx-auto max-w-[1280px] px-4 sm:px-6 lg:px-8 min-h-[68px] md:h-[74px] py-2 flex items-center justify-between gap-3 md:gap-4">
    <!-- Kiri: Brand Lockup + Pembatas Vertikal -->
    <div class="flex items-center gap-3 md:gap-4 min-w-0">
      <a
        href={isHomePage ? '#top' : '/'}
        class="group inline-flex items-center gap-2.5 min-h-[44px] min-w-0 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
      >
        <span
          class="flex h-9 w-9 sm:h-10 sm:w-10 shrink-0 items-center justify-center rounded-xl bg-primary-dark text-gold shadow-sm transition-transform group-hover:scale-[1.03]"
          aria-hidden="true"
        >
          <svg viewBox="0 0 36 36" class="h-5 w-5 sm:h-6 sm:w-6" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M18 5L29 12.5V28H7V12.5L18 5Z" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" />
            <path d="M18 13V28M12 18.5C14.2 17.3 16.3 17.5 18 19C19.7 17.5 21.8 17.3 24 18.5" stroke="#ECFDF5" stroke-width="2" stroke-linecap="round" />
          </svg>
        </span>
        <span class="flex flex-col leading-tight min-w-0">
          <span class="font-heading text-sm sm:text-base font-extrabold tracking-tight text-primary-dark">
            MI TPI Al-Fuad
          </span>
          <span class="text-[10.5px] sm:text-[11px] font-semibold text-accent leading-tight">
            Madrasah Ibtidaiyah (Setara SD Islam) &bull; Poris Gaga
          </span>
        </span>
      </a>

      <!-- Pembatas Vertikal -->
      <span class="hidden lg:block h-7 w-px bg-line-subtle shrink-0" aria-hidden="true"></span>

      <!-- Desktop Horizontal Menu + Dropdowns -->
      <nav aria-label="Navigasi Utama" class="hidden lg:flex items-center gap-1">
        <a
          href={isHomePage ? '#top' : '/'}
          class="inline-flex items-center min-h-[44px] px-3 text-sm font-bold text-primary-dark hover:text-accent transition-colors"
        >
          Beranda
        </a>

        <!-- Dropdown Tentang -->
        <div class="relative group">
          <button
            type="button"
            class="inline-flex items-center gap-1 min-h-[44px] px-3 text-sm font-medium text-ink-subheading hover:text-primary-dark transition-colors"
          >
            <span>Tentang</span>
            <ChevronDown class="h-3.5 w-3.5 text-ink-caption transition-transform group-hover:rotate-180" aria-hidden="true" />
          </button>
          <div class="invisible opacity-0 translate-y-1 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 group-focus-within:visible group-focus-within:opacity-100 transition-all duration-150 absolute left-0 top-full pt-1 w-52">
            <ul class="rounded-xl bg-white border border-line-subtle shadow-lg py-1.5">
              {
                aboutLinks.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      class="block px-4 py-2 text-xs font-semibold text-ink-subheading hover:bg-accent-surface hover:text-primary-dark transition-colors"
                    >
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <!-- Dropdown Unit Sekolah -->
        <div class="relative group">
          <button
            type="button"
            class="inline-flex items-center gap-1 min-h-[44px] px-3 text-sm font-medium text-ink-subheading hover:text-primary-dark transition-colors"
          >
            <span>Unit Sekolah</span>
            <ChevronDown class="h-3.5 w-3.5 text-ink-caption transition-transform group-hover:rotate-180" aria-hidden="true" />
          </button>
          <div class="invisible opacity-0 translate-y-1 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 group-focus-within:visible group-focus-within:opacity-100 transition-all duration-150 absolute left-0 top-full pt-1 w-60">
            <ul class="rounded-xl bg-white border border-line-subtle shadow-lg py-1.5">
              {
                schoolLinks.map((unit) => (
                  <li>
                    <a
                      href={unit.href}
                      data-nav-unit-id={unit.unitId}
                      class="block px-4 py-2 text-xs font-semibold text-ink-subheading hover:bg-accent-surface hover:text-primary-dark transition-colors"
                    >
                      {unit.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <a
          href={`${prefix}#kabar`}
          class="inline-flex items-center min-h-[44px] px-3 text-sm font-medium text-ink-subheading hover:text-primary-dark transition-colors whitespace-nowrap"
        >
          Kabar
        </a>

        <a
          href={`${prefix}#biaya-ppdb`}
          class="inline-flex items-center min-h-[44px] px-3 text-sm font-medium text-ink-subheading hover:text-primary-dark transition-colors whitespace-nowrap"
        >
          Biaya PPDB
        </a>
      </nav>
    </div>

    <!-- Kanan: Tombol Daftar Luminous Gold + Hamburger Mobile -->
    <div class="flex items-center gap-2 shrink-0">
      <a
        href={`${prefix}#daftar-ppdb`}
        class="hidden sm:inline-flex items-center justify-center min-h-[44px] rounded-xl bg-gold hover:bg-gold-hover px-4 py-2 text-xs sm:text-sm font-bold text-ink-heading shadow-sm transition-colors whitespace-nowrap focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold"
      >
        Daftar PPDB
      </a>

      <button
        id="mobile-menu-toggle"
        type="button"
        class="lg:hidden inline-flex items-center justify-center min-h-[44px] min-w-[44px] rounded-xl border border-line-subtle bg-white text-primary-dark hover:bg-primary-surface transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
        aria-label="Buka menu navigasi"
      >
        <Menu id="mobile-icon-open" class="h-5 w-5" aria-hidden="true" />
        <X id="mobile-icon-close" class="hidden h-5 w-5" aria-hidden="true" />
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div id="mobile-nav-drawer" class="hidden lg:hidden border-t border-line-subtle bg-white max-h-[80vh] overflow-y-auto">
    <nav aria-label="Menu Mobile" class="divide-y divide-line-subtle">
      <a
        href={isHomePage ? '#top' : '/'}
        data-mobile-nav-link
        class="flex items-center justify-between min-h-[46px] bg-primary-dark px-5 py-3 text-sm font-bold text-white"
      >
        <span>Beranda</span>
      </a>

      <div>
        <div class="bg-primary-dark px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-gold-light">
          Tentang Kami
        </div>
        <div class="bg-white divide-y divide-line-subtle">
          {
            aboutLinks.map((item) => (
              <a
                href={item.href}
                data-mobile-nav-link
                class="flex items-center min-h-[44px] pl-8 pr-5 py-2 text-sm font-medium text-ink-subheading hover:bg-accent-surface hover:text-primary-dark"
              >
                {item.label}
              </a>
            ))
          }
        </div>
      </div>

      <div>
        <div class="bg-primary-dark px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-gold-light">
          Unit Sekolah
        </div>
        <div class="bg-white divide-y divide-line-subtle">
          {
            schoolLinks.map((unit) => (
              <a
                href={unit.href}
                data-mobile-nav-link
                data-nav-unit-id={unit.unitId}
                class="flex items-center min-h-[44px] pl-8 pr-5 py-2 text-sm font-medium text-ink-subheading hover:bg-accent-surface hover:text-primary-dark"
              >
                {unit.label}
              </a>
            ))
          }
        </div>
      </div>

      <a
        href={`${prefix}#kabar`}
        data-mobile-nav-link
        class="flex items-center min-h-[46px] bg-white px-5 py-3 text-sm font-semibold text-ink-heading hover:bg-accent-surface"
      >
        Kabar &amp; Agenda
      </a>

      <a
        href={`${prefix}#biaya-ppdb`}
        data-mobile-nav-link
        class="flex items-center min-h-[46px] bg-white px-5 py-3 text-sm font-semibold text-ink-heading hover:bg-accent-surface"
      >
        Biaya PPDB
      </a>
    </nav>

    <div class="p-4 bg-surface-alabaster border-t border-line-subtle grid grid-cols-1 sm:grid-cols-2 gap-2.5">
      <a
        href={`${prefix}#daftar-ppdb`}
        data-mobile-nav-link
        class="inline-flex items-center justify-center min-h-[44px] rounded-xl bg-gold hover:bg-gold-hover px-4 py-2.5 text-sm font-bold text-ink-heading"
      >
        Daftar PPDB Online
      </a>
      <a
        href={quickWaUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-mobile-nav-link
        class="inline-flex items-center justify-center gap-2 min-h-[44px] rounded-xl bg-primary hover:bg-primary-dark px-4 py-2.5 text-sm font-semibold text-white"
      >
        <MessageCircle class="h-4 w-4 shrink-0" aria-hidden="true" />
        <span>Chat WA ({SITE_CONFIG.contact.whatsappDisplay})</span>
      </a>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const drawer = document.getElementById('mobile-nav-drawer');
    const iconOpen = document.getElementById('mobile-icon-open');
    const iconClose = document.getElementById('mobile-icon-close');

    if (toggleBtn && drawer) {
      const setMenuOpen = (isOpen) => {
        drawer.classList.toggle('hidden', !isOpen);
        toggleBtn.setAttribute('aria-expanded', String(isOpen));
        toggleBtn.setAttribute('aria-label', isOpen ? 'Tutup menu navigasi' : 'Buka menu navigasi');
        if (iconOpen) iconOpen.classList.toggle('hidden', isOpen);
        if (iconClose) iconClose.classList.toggle('hidden', !isOpen);
      };

      toggleBtn.addEventListener('click', () => {
        const currentlyOpen = toggleBtn.getAttribute('aria-expanded') === 'true';
        setMenuOpen(!currentlyOpen);
      });

      drawer.querySelectorAll('[data-mobile-nav-link]').forEach((link) => {
        link.addEventListener('click', () => setMenuOpen(false));
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && toggleBtn.getAttribute('aria-expanded') === 'true') {
          setMenuOpen(false);
          toggleBtn.focus();
        }
      });
    }

    document.querySelectorAll('[data-nav-unit-id]').forEach((link) => {
      link.addEventListener('click', () => {
        const unitId = link.getAttribute('data-nav-unit-id');
        if (unitId) {
          window.dispatchEvent(new CustomEvent('campus:select-slide', { detail: { unitId } }));
        }
      });
    });
  })();
</script>
