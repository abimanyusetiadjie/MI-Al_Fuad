---
import '../styles/global.css';
import SEOHead, { type Props as SEOHeadProps } from '@/components/layout/SEOHead.astro';
import Navbar from '@/components/layout/Navbar.astro';
import Footer from '@/components/layout/Footer.astro';
import FloatingWhatsApp from '@/components/ui/FloatingWhatsApp.astro';

export interface Props extends SEOHeadProps {}

const seoProps = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <SEOHead {...seoProps} />
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('js-reveal');
      }
    </script>
  </head>
  <body
    id="top"
    class="min-h-screen flex flex-col bg-surface-alabaster text-ink-body antialiased selection:bg-primary/15 selection:text-primary-dark"
  >
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:rounded-lg focus:bg-primary-dark focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white focus:shadow-lg"
    >
      Lewati ke konten utama
    </a>

    <Navbar />

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <Footer />
    <FloatingWhatsApp />

    <script is:inline>
      (function () {
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // 1. Scroll Reveal Engine (Anti-Stuck: reveals above-fold, scrolled-past, and anchor-jumped blocks)
        const revealEls = Array.from(document.querySelectorAll('[data-reveal]'));
        const markVisible = (el) => {
          if (el.classList.contains('is-visible')) return;
          const delay = el.getAttribute('data-reveal-delay');
          if (delay) el.style.transitionDelay = delay + 'ms';
          el.classList.add('is-visible');
        };

        const revealInOrAboveViewport = () => {
          const thresholdY = (window.innerHeight || 800) + 120;
          let remaining = 0;
          revealEls.forEach((el) => {
            if (el.classList.contains('is-visible')) return;
            const rect = el.getBoundingClientRect();
            if (rect.top <= thresholdY) {
              markVisible(el);
            } else {
              remaining++;
            }
          });
          return remaining;
        };

        if (!reducedMotion && 'IntersectionObserver' in window) {
          const revealObserver = new IntersectionObserver(
            (entries, observer) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting || entry.boundingClientRect.top <= (window.innerHeight || 800)) {
                  markVisible(entry.target);
                  observer.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.01, rootMargin: '120px 0px 120px 0px' },
          );

          // Segera tampilkan blok di viewport awal atau di atas posisi scroll saat ini
          revealInOrAboveViewport();
          revealEls.forEach((el) => {
            if (!el.classList.contains('is-visible')) {
              revealObserver.observe(el);
            }
          });

          let scrollTicking = false;
          const onScrollOrHash = () => {
            if (scrollTicking) return;
            scrollTicking = true;
            requestAnimationFrame(() => {
              scrollTicking = false;
              const left = revealInOrAboveViewport();
              if (left === 0) {
                window.removeEventListener('scroll', onScrollOrHash);
                window.removeEventListener('hashchange', onScrollOrHash);
              }
            });
          };

          window.addEventListener('scroll', onScrollOrHash, { passive: true });
          window.addEventListener('hashchange', onScrollOrHash, { passive: true });
        } else {
          revealEls.forEach((el) => markVisible(el));
        }

        // 2. Animated Metric Counter Engine (EaseOutExpo)
        const counterEls = document.querySelectorAll('[data-counter-target]');
        const runCounter = (el) => {
          if (el.getAttribute('data-counted') === 'true') return;
          el.setAttribute('data-counted', 'true');
          const target = Number(el.getAttribute('data-counter-target') || '0');
          const prefix = el.getAttribute('data-counter-prefix') || '';
          const suffix = el.getAttribute('data-counter-suffix') || '';
          if (reducedMotion || !target) {
            el.textContent = prefix + target.toLocaleString('id-ID') + suffix;
            return;
          }

          const duration = 1200;
          let start = null;
          const step = (ts) => {
            if (!start) start = ts;
            const progress = Math.min((ts - start) / duration, 1);
            const eased = progress === 1 ? 1 : 1 - Math.pow(2, -10 * progress);
            const current = Math.round(eased * target);
            el.textContent = prefix + current.toLocaleString('id-ID') + suffix;
            if (progress < 1) {
              requestAnimationFrame(step);
            }
          };
          requestAnimationFrame(step);
        };

        if ('IntersectionObserver' in window) {
          const counterObserver = new IntersectionObserver(
            (entries, observer) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  runCounter(entry.target);
                  observer.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.05, rootMargin: '60px 0px 60px 0px' },
          );
          counterEls.forEach((el) => counterObserver.observe(el));
        } else {
          counterEls.forEach((el) => runCounter(el));
        }
      })();
    </script>
  </body>
</html>
